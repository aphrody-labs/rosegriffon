	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint:fix",
		"type-check": "turbo run type-check",
		"test": "turbo run test",
		"clean": "turbo run clean && rm -rf node_modules .turbo",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"azalee": "bun bin/azalee.ts",
		"azalee:compile": "bun build bin/azalee.ts --compile --minify --sourcemap --bytecode --outfile bin/azalee",
		"azalee:dev": "bun --filter @rose-griffon/azalee dev",
		"website:dev": "bun --filter @rose-griffon/website dev",
		"rag:poc": "bun packages/cron/src/tasks/ie-crawl/rag-poc.ts",
		"rag:ingest": "bun scripts/rag-ingest.ts",
		"docs:map": "bun scripts/generate-repo-map.ts",
		"docs:bundle": "bun scripts/bundle-llms-docs.ts",
		"docs:check-links": "bun scripts/check-docs-links.ts",
		"docs:lint": "bunx markdownlint-cli2 \"docs/**/*.md\" \"!docs/awesome-markdown.md\" \"!docs/bun-markdown.md\"",
		"docs:build": "bun run docs:map && bun run docs:bundle && bun run docs:check-links && bun run docs:lint",
		"iecode:dotnet:build": "dotnet build iecode/IECODE.sln -c Release",
		"iecode:dotnet:test": "dotnet test iecode/IECODE.sln -c Release",
		"iecode:napi:build": "dotnet build iecode/vendor/node-api-dotnet/NodeApi.sln -c Release",
		"iecode:sync:gamedata": "bun iecode/scripts/sync-gamedata.ts",
		"iecode:scrape": "bun iecode/packages/steam-sync/src/cli.ts",
		"iecode:steam:sync": "bun iecode/packages/steam-sync/src/cli.ts",
		"iecode:steam:depots": "bun iecode/packages/steam-sync/src/cli.ts --list",
		"iecode:data:accumulate": "bun iecode/packages/pipeline/src/cli.ts accumulate",
		"iecode:data:export": "bun iecode/packages/pipeline/src/cli.ts export",
		"iecode:data:serve": "bun iecode/packages/pipeline/src/cli.ts serve"
	},
