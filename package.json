{
	"name": "@rose-griffon/monorepo",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Rose Griffon monorepo — site communautaire (azalee wiki IEVR + website rosegriffon + bot Discord). Stack Next 16.2 / React 19.2 / Bun 1.3 / Supabase / Turborepo.",
	"engines": {
		"bun": ">=1.3.14"
	},
	"packageManager": "bun@1.3.14",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"next": "^16.2.6",
			"react": "^19.2.6",
			"react-dom": "^19.2.6",
			"typescript": "^6.0.3",
			"tailwindcss": "^4.3.0",
			"@tailwindcss/postcss": "^4.3.0",
			"@tailwindcss/typography": "^0.5.19",
			"tw-animate-css": "^1.4.0",
			"tailwindcss-animate": "^1.0.7",
			"tailwind-merge": "^3.4.0",
			"class-variance-authority": "^0.7.1",
			"clsx": "^2.1.1",
			"zod": "^4.4.3",
			"@supabase/supabase-js": "^2.105.4",
			"@supabase/ssr": "^0.6.1",
			"better-auth": "^1.6.11",
			"@rpbey/discordx": "^0.1.1",
			"discord.js": "^14.26.3",
			"discord-api-types": "^0.38.47",
			"tsyringe": "^4.10.0",
			"reflect-metadata": "^0.2.2",
			"lucide-react": "^0.562.0",
			"sharp": "^0.34.5",
			"sonner": "^2.0.7",
			"@tanstack/react-query": "^5.99.1",
			"date-fns": "^4.1.0",
			"eslint": "^9.39.4",
			"eslint-config-next": "^16.2.6",
			"@next/eslint-plugin-next": "^16.2.6",
			"@next/bundle-analyzer": "^16.2.6",
			"eslint-plugin-better-tailwindcss": "^4.4.1",
			"eslint-plugin-jsx-a11y": "^6.10.2",
			"eslint-plugin-react-compiler": "^19.1.0-rc.2",
			"eslint-plugin-oxlint": "^1.65.0",
			"oxlint": "^1.65.0",
			"vitest": "^4.1.6",
			"@vitejs/plugin-react": "^5.2.0",
			"jsdom": "^27.4.0",
			"@testing-library/jest-dom": "^6.9.1",
			"@types/bun": "^1.3.14",
			"@types/node": "^25.8.0",
			"@types/react": "19.2.14",
			"@types/react-dom": "19.2.3",
			"babel-plugin-react-compiler": "^1.0.0",
			"recharts": "3.8.0",
			"swr": "^2.3.6",
			"@tanstack/query-sync-storage-persister": "^5.99.1",
			"@tanstack/react-query-persist-client": "^5.99.1",
			"prettier": "^3.8.3"
		}
	},
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint:fix",
		"type-check": "turbo run type-check",
		"test": "turbo run test",
		"clean": "turbo run clean && rm -rf node_modules .turbo",
		"format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore",
		"azalee:dev": "bun --filter @rose-griffon/azalee dev",
		"website:dev": "bun --filter @rose-griffon/website dev",
		"bot:dev": "bun --filter @rose-griffon/bot dev",
		"bot:start": "bun --filter @rose-griffon/bot start"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@vercel/edge-config": "^1.4.3",
		"eslint": "catalog:",
		"geist": "^1.7.0",
		"oxlint": "catalog:",
		"prettier": "catalog:",
		"shadcn": "^4.8.3",
		"turbo": "^2.9.14",
		"typescript": "catalog:"
	}
}
