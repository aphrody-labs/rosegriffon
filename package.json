{
	"name": "@rose-griffon/monorepo",
	"version": "0.1.0",
	"private": true,
	"description": "Rose Griffon monorepo — site communautaire (azalee wiki IEVR + website rosegriffon + bot Discord). Stack Next 16.2 / React 19.2 / Bun 1.3 / Supabase / Turborepo.",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"next": "^16.2.6",
			"react": "^19.2.6",
			"react-dom": "^19.2.6",
			"typescript": "^6.0.3",
			"tailwindcss": "^4.3.0",
			"@tailwindcss/postcss": "^4.3.0",
			"@tailwindcss/typography": "^0.5.19",
			"tw-animate-css": "^1.4.0",
			"tailwindcss-animate": "^1.0.7",
			"tailwind-merge": "^3.4.0",
			"class-variance-authority": "^0.7.1",
			"clsx": "^2.1.1",
			"zod": "^4.4.3",
			"@supabase/supabase-js": "^2.105.4",
			"@supabase/ssr": "^0.6.1",
			"better-auth": "^1.6.11",
			"@rpbey/discordx": "^0.1.1",
			"discord.js": "^14.26.3",
			"discord-api-types": "^0.38.47",
			"tsyringe": "^4.10.0",
			"reflect-metadata": "^0.2.2",
			"lucide-react": "^0.562.0",
			"sharp": "^0.34.5",
			"sonner": "^2.0.7",
			"@tanstack/react-query": "^5.99.1",
			"date-fns": "^4.1.0",
			"@next/bundle-analyzer": "^16.2.6",
			"oxlint": "^1.65.0",
			"vitest": "^4.1.6",
			"@vitejs/plugin-react": "^5.2.0",
			"jsdom": "^27.4.0",
			"@testing-library/jest-dom": "^6.9.1",
			"@types/bun": "^1.3.14",
			"@types/node": "^25.8.0",
			"@types/react": "19.2.14",
			"@types/react-dom": "19.2.3",
			"babel-plugin-react-compiler": "^1.0.0",
			"recharts": "3.8.0",
			"swr": "^2.3.6",
			"@tanstack/query-sync-storage-persister": "^5.99.1",
			"@tanstack/react-query-persist-client": "^5.99.1"
		}
	},
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint:fix",
		"type-check": "turbo run type-check",
		"test": "turbo run test",
		"clean": "turbo run clean && rm -rf node_modules .turbo",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"azalee": "bun bin/azalee.ts",
		"azalee:compile": "bun build bin/azalee.ts --compile --minify --sourcemap --bytecode --outfile bin/azalee",
		"azalee:dev": "bun --filter @rose-griffon/azalee dev",
		"website:dev": "bun --filter @rose-griffon/website dev",
		"bot:dev": "bun --filter @rose-griffon/bot dev",
		"bot:start": "bun --filter @rose-griffon/bot start",
		"docs:map": "bun scripts/generate-repo-map.ts",
		"docs:bundle": "bun scripts/bundle-llms-docs.ts",
		"docs:check-links": "bun scripts/check-docs-links.ts",
		"docs:lint": "bunx markdownlint-cli2 \"docs/**/*.md\" \"!docs/awesome-markdown.md\" \"!docs/bun-markdown.md\"",
		"docs:build": "bun run docs:map && bun run docs:bundle && bun run docs:check-links && bun run docs:lint"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@vercel/edge-config": "^1.4.3",
		"commander": "^12.0.0",
		"dotenv": "^16.4.5",
		"geist": "^1.7.0",
		"oxfmt": "^0.52.0",
		"oxlint": "catalog:",
		"turbo": "^2.9.14",
		"typescript": "catalog:",
		"wanakana": "^5.3.1"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"packageManager": "bun@1.3.14",
	"overrides": {
		"kysely": "0.28.2"
	},
	"dependencies": {
		"@streamparser/json": "^0.0.22",
		"pg": "^8.17.1"
	}
}
