{
  "name": "@aphrody/shenron-engine",
  "version": "1.4.7",
  "private": false,
  "description": "Unified full-stack Shenron game engine, GPU backend, WebGPU/WASM pipeline, vector canvas, and deterministic combat core.",
  "homepage": "https://dragonballfr.com",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/shenron.git",
    "directory": "packages/engine"
  },
  "files": [
    "src",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./pixel-engine": "./src/pixel_engine.ts",
    "./toriyama3d": "./src/toriyama3d.ts",
    "./manga-scene": "./src/manga-scene.ts",
    "./glb-scene": "./src/glb-scene.ts",
    "./xv2-character": "./src/xv2-character.ts",
    "./sprite-atlas": "./src/sprite-atlas.ts",
    "./combat-atlas": "./src/combat-atlas.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "lint": "oxlint src test --ignore-pattern src/wasm",
    "test": "bun test",
    "typecheck": "bun check --project tsconfig.json",
    "build:wasm": "bun scripts/build-wasm.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "shenron": {
    "runtime": {
      ".": "pure",
      "./pixel-engine": "pure",
      "./toriyama3d": "pure",
      "./manga-scene": "pure",
      "./glb-scene": "pure",
      "./xv2-character": "pure",
      "./sprite-atlas": "pure",
      "./combat-atlas": "pure"
    }
  }
}
