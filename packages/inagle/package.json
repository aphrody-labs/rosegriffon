{
  "name": "@rosegriffon/inagle",
  "version": "1.0.0",
  "description": "Universal Game Data API for Inazuma Eleven: Victory Road — parsers, types, and tools for IEVR game data",
  "keywords": [
    "cfg-bin",
    "game-data",
    "iecode",
    "ievr",
    "inazuma-eleven",
    "parser",
    "victory-road",
    "zukan"
  ],
  "homepage": "https://azalee.rosegriffon.fr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rose-griffon/rosegriffon.git",
    "directory": "packages/inagle"
  },
  "bin": {
    "inagle": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "bun --bun tsc -p tsconfig.build.json",
    "cli": "bun src/cli.ts",
    "push": "bun src/cli.ts push",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "lint": "bunx oxlint -c ../../.oxlintrc.json -A style -A pedantic -A restriction src",
    "lint:fix": "bunx oxlint -c ../../.oxlintrc.json -A style -A pedantic -A restriction --fix src",
    "type-check": "bun --bun tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@aphrody-code/bxc": "catalog:",
    "@aphrody-code/zukan": "catalog:",
    "@leeoniya/ufuzzy": "catalog:",
    "@streamparser/json": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "cheerio": "catalog:",
    "commander": "catalog:",
    "dotenv": "catalog:",
    "fengari": "catalog:",
    "hono": "catalog:",
    "jsonwebtoken": "catalog:",
    "kuroshiro": "catalog:",
    "kuroshiro-analyzer-kuromoji": "catalog:",
    "pg": "catalog:",
    "picocolors": "catalog:",
    "web-tree-sitter": "catalog:",
    "zod": "catalog:",
    "zod-to-json-schema": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/jsonwebtoken": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "trustedDependencies": [
    "tree-sitter",
    "tree-sitter-c",
    "esbuild"
  ]
}
