{
	"name": "@rose-griffon/inagle",
	"version": "1.2.0",
	"description": "Universal Game Data API for Inazuma Eleven: Victory Road — parsers, types, and tools for IEVR game data",
	"keywords": [
		"cfg-bin",
		"game-data",
		"iecode",
		"ievr",
		"inazuma-eleven",
		"parser",
		"victory-road",
		"zukan"
	],
	"homepage": "https://azalee.rosegriffon.fr",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/rose-griffon/rosegriffon.git",
		"directory": "packages/inagle"
	},
	"bin": {
		"inagle": "./dist/cli.js"
	},
	"files": [
		"dist",
		"src"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./*": {
			"types": "./dist/*.d.ts",
			"import": "./dist/*.js",
			"default": "./dist/*.js"
		}
	},
	"publishConfig": {
		"main": "./dist/index.js",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"import": "./dist/index.js",
				"types": "./dist/index.d.ts"
			},
			"./*": {
				"import": "./dist/*.js",
				"types": "./dist/*.d.ts"
			}
		},
		"access": "public",
		"registry": "https://npm.pkg.github.com"
	},
	"scripts": {
		"build": "bun run tsc -p tsconfig.build.json",
		"cli": "bun src/cli.ts",
		"entries": "bun src/scripts/generate-entries.ts",
		"push": "bun src/cli-push.ts",
		"serve": "bun src/scripts/serve-data.ts",
		"compile": "bun src/scripts/build-standalone.ts",
		"prepublishOnly": "bun run build",
		"test": "bun test",
		"lint": "bunx oxlint -c ../../.oxlintrc.json src",
		"lint:fix": "bunx oxlint -c ../../.oxlintrc.json --fix src",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"@leeoniya/ufuzzy": "^1.0.19",
		"@streamparser/json": "^0.0.22",
		"@supabase/supabase-js": "catalog:",
		"cheerio": "^1.2.0",
		"commander": "^15.0.0",
		"fengari": "^0.1.5",
		"hono": "^4.12.23",
		"jsonwebtoken": "^9.0.3",
		"kuroshiro": "^1.2.0",
		"kuroshiro-analyzer-kuromoji": "^1.1.0",
		"picocolors": "^1.1.1",
		"web-tree-sitter": "^0.26.9",
		"zod": "catalog:",
		"zod-to-json-schema": "^3.25.2"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "catalog:",
		"@types/pg": "^8.20.0",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"trustedDependencies": [
		"tree-sitter",
		"tree-sitter-c",
		"esbuild"
	]
}
