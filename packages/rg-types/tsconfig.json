{
	"extends": "@rose-griffon/config/tsconfig-base.json",
	"compilerOptions": {
		"outDir": "dist",
		"noEmit": true,
		"declaration": false,
		"baseUrl": ".",
		"paths": {
			"@rose-griffon/db": ["../db/src/index.ts"],
			"@rose-griffon/db/*": ["../db/src/*"]
		}
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
