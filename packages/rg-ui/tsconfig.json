{
	"extends": "../config/tsconfig-nextjs.json",
	"compilerOptions": {
		"types": ["react", "react-dom", "bun"],
		"paths": {
			"@/lib/utils": ["./src/lib/utils.ts"],
			"@/components/*": ["./src/components/*"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"],
	"exclude": ["node_modules", "dist"]
}
