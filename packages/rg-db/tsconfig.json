{
  "extends": "../rg-config/tsconfig-base.json",
  "compilerOptions": {
    "types": ["bun"],
    "lib": ["ESNext", "DOM"],
    "noEmit": true,
    "jsx": "preserve",
    "rootDir": "..",
    "paths": {
      "@rosegriffon/config": ["../rg-config"],
      "@rosegriffon/config/*": ["../rg-config/*"],
      "@rosegriffon/db": ["./src/index.ts"],
      "@rosegriffon/db/*": ["./src/*"],
      "@rosegriffon/types": ["../rg-types/src/index.ts"],
      "@rosegriffon/types/*": ["../rg-types/src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
