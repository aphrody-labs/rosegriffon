{
	"extends": "../config/tsconfig-base.json",
	"compilerOptions": {
		"types": ["bun"],
		"lib": ["ESNext", "DOM"],
		"noEmit": true,
		"jsx": "preserve",
		"baseUrl": ".",
		"ignoreDeprecations": "6.0",
		"rootDir": "..",
		"paths": {
			"@rose-griffon/db": ["./src/index.ts"],
			"@rose-griffon/db/*": ["./src/*"],
			"@rose-griffon/types": ["../types/src/index.ts"],
			"@rose-griffon/types/*": ["../types/src/*"]
		}
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
