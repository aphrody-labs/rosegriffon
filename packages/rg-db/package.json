{
  "name": "@rosegriffon/db",
  "version": "1.0.7",
  "private": false,
  "description": "Accès PostgreSQL partagé, façades SQL et types Database générés (site + bot)",
  "license": "UNLICENSED",
  "files": [
    "README.md",
    "scripts",
    "src",
    "tsconfig.json"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts",
    "./service": "./src/service.ts",
    "./redis": "./src/redis.ts",
    "./storage": "./src/storage.ts",
    "./stats": "./src/services/stats.ts",
    "./types": "./src/types.ts",
    "./platform": "./src/platform.ts",
    "./achillea": "./src/achillea.ts",
    "./achillea-sql": "./src/achillea-sql.ts",
    "./inagle": "./src/inagle.ts",
    "./inagle-sql": "./src/inagle-sql.ts",
    "./pg": "./src/pg.ts",
    "./bun-sql": "./src/bun-sql.ts",
    "./postgres-client": "./src/postgres-client.ts",
    "./kysely-types": "./src/kysely-types.ts",
    "./schema": "./src/schema/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "types:gen": "bun scripts/types-gen.ts",
    "type-check": "bun --bun tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint -c ../config/oxlintrc.json src",
    "typecheck": "bun --bun tsc --noEmit"
  },
  "dependencies": {
    "@aphrody/sql": "catalog:",
    "@rosegriffon/types": "workspace:*",
    "@supabase/ssr": "catalog:",
    "kysely": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "kysely-supabase": "^0.2.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.3-aphrody.4"
  }
}
