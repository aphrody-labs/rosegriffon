{
  "name": "@rosegriffon/lua-plugin",
  "version": "1.5.0",
  "description": "End-to-end Lua 5.2 loader, runtime, LSP and Next.js / Bun bundler plugin for RoseGriffon",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./bun": {
      "types": "./dist/bun.d.ts",
      "import": "./dist/bun.js",
      "default": "./dist/bun.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "default": "./dist/next.js"
    },
    "./vm": {
      "types": "./dist/vm.d.ts",
      "import": "./dist/vm.js",
      "default": "./dist/vm.js"
    },
    "./bytecode": {
      "types": "./dist/bytecode.d.ts",
      "import": "./dist/bytecode.js",
      "default": "./dist/bytecode.js"
    },
    "./ast": {
      "types": "./dist/ast.d.ts",
      "import": "./dist/ast.js",
      "default": "./dist/ast.js"
    },
    "./lsp": {
      "types": "./dist/lsp.d.ts",
      "import": "./dist/lsp.js",
      "default": "./dist/lsp.js"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "import": "./dist/loader.js",
      "default": "./dist/loader.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "test": "bun test",
    "prepublishOnly": "bun run build.ts"
  },
  "keywords": [
    "lua",
    "lua52",
    "nextjs",
    "turbopack",
    "bun",
    "bun-plugin",
    "rosegriffon",
    "inazuma-eleven",
    "rea",
    "bytecode",
    "lsp",
    "webpack"
  ],
  "author": "RoseGriffon Team <contact@rosegriffon.fr>",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/rosegriffon.git",
    "directory": "packages/rg-lua"
  }
}
