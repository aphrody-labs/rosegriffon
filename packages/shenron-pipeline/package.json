{
  "name": "@aphrody/shenron-pipeline",
  "version": "1.4.7",
  "private": false,
  "description": "Shenron compute clients and Dragon Ball data pipeline: AI, Aphrody services, crawl, OCR and RAG workflows",
  "homepage": "https://dragonballfr.com",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/shenron.git",
    "directory": "packages/pipeline"
  },
  "bin": {
    "pipeline": "./src/cli.ts"
  },
  "files": [
    "src",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./koharu": "./src/koharu.ts",
    "./ai/config": "./src/ai/config.ts",
    "./ai/prompts": "./src/ai/prompts.ts",
    "./ai/chat": "./src/ai/chat.ts",
    "./ai/embeddings": "./src/ai/embeddings.ts",
    "./ai/ports": "./src/ai/ports.ts",
    "./ai/generate": "./src/ai/generate.ts",
    "./ai/grounding": "./src/ai/grounding.ts",
    "./ai/eval": "./src/ai/eval.ts",
    "./ai/aphrody": "./src/ai/aphrody.ts",
    "./ai/provider": "./src/ai/provider.ts",
    "./ai/wire": "./src/ai/wire.ts",
    "./aphrody/remote-ocr": "./src/aphrody/remote-ocr.ts",
    "./aphrody/a2a-transport": "./src/aphrody/a2a-transport.ts",
    "./aphrody/a2a": "./src/aphrody/a2a.ts",
    "./aphrody/cli": "./src/aphrody/cli.ts",
    "./aphrody/compute": "./src/aphrody/compute.ts",
    "./aphrody/native": "./src/aphrody/native.ts",
    "./yolo-web": "./src/yolo-web/index.ts",
    "./manga-ocr": "./src/manga-ocr.ts",
    "./remote-ocr": "./src/aphrody/remote-ocr.ts",
    "./ai": "./src/ai/index.ts",
    "./aphrody": "./src/aphrody/index.ts",
    "./aphrody/embeddings": "./src/aphrody/shenron-embeddings.ts",
    "./testing/live-rag": "./src/testing/live-rag.ts",
    "./ai/native": "./src/ai/native.ts",
    "./agent-home": "./src/agent-home.ts",
    "./aphrody/jobs": "./src/aphrody/jobs.ts",
    "./dragon-ball": "./src/dragon-ball/index.ts",
    "./dragon-ball/catalogue": "./src/dragon-ball/catalogue.ts",
    "./aphrody/native-commands": "./src/aphrody/native-commands.ts",
    "./re-wasm-web": "./src/re-wasm-web.ts",
    "./runtime/python": "./src/runtime/python.ts",
    "./ai/canon-judgment": "./src/ai/canon-judgment.ts",
    "./ai/jev-provider": "./src/ai/jev-provider.ts",
    "./ai/vector-reader": "./src/ai/vector-reader.ts",
    "./ai/vector-sidecar": "./src/ai/vector-sidecar.ts",
    "./dragon-ball/crawl-ingest": "./src/dragon-ball/crawl-ingest.ts",
    "./dragon-ball/manga-publication-contract": "./src/dragon-ball/manga-publication-contract.ts",
    "./dragon-ball/sosh-reader-manifest": "./src/dragon-ball/sosh-reader-manifest.ts",
    "./dragon-ball/assets": "./src/dragon-ball/assets.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "pipeline": "bun src/cli.ts",
    "build": "bun build src/cli.ts --target=bun --external=sharp --external=zod --external=ai --external='@ai-sdk/*' --outfile=dist/pipeline",
    "lint": "oxlint src",
    "test": "bun test --path-ignore-patterns='**/*.live.test.ts'",
    "typecheck": "bun check --project tsconfig.json && bun check --project tsconfig.scripts.json",
    "rag:prepare": "bun scripts/prepare-live-rag.ts",
    "rag:test": "bun scripts/test-live-rag.ts"
  },
  "dependencies": {
    "@aphrody/paths": "catalog:",
    "sharp": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "shenron": {
    "runtime": {
      ".": "bun",
      "./koharu": "pure",
      "./ai/config": "pure",
      "./ai/prompts": "pure",
      "./ai/chat": "pure",
      "./ai/embeddings": "server",
      "./ai/ports": "pure",
      "./ai/generate": "server",
      "./ai/grounding": "pure",
      "./ai/eval": "pure",
      "./ai/aphrody": "pure",
      "./ai/provider": "server",
      "./ai/wire": "pure",
      "./aphrody/remote-ocr": "bun",
      "./aphrody/a2a-transport": "server",
      "./aphrody/a2a": "server",
      "./aphrody/cli": "bun",
      "./aphrody/compute": "server",
      "./aphrody/native": "bun",
      "./manga-ocr": "bun",
      "./remote-ocr": "bun",
      "./ai": "pure",
      "./aphrody": "bun",
      "./aphrody/embeddings": "server",
      "./testing/live-rag": "bun",
      "./ai/native": "bun",
      "./agent-home": "server",
      "./aphrody/jobs": "bun",
      "./dragon-ball": "bun",
      "./dragon-ball/catalogue": "pure",
      "./aphrody/native-commands": "bun",
      "./re-wasm-web": "pure",
      "./runtime/python": "bun",
      "./ai/canon-judgment": "pure",
      "./ai/jev-provider": "bun",
      "./ai/vector-reader": "bun",
      "./ai/vector-sidecar": "bun",
      "./dragon-ball/crawl-ingest": "bun",
      "./dragon-ball/manga-publication-contract": "server",
      "./dragon-ball/sosh-reader-manifest": "pure",
      "./dragon-ball/assets": "bun"
    }
  }
}
