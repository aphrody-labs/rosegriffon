{
  "name": "@rosegriffon/achillea-client",
  "version": "1.4.4",
  "private": false,
  "description": "Versioned HTTP client and runtime contracts for the Achillea guild API",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "achillea": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./v1": "./src/v1/index.ts",
    "./cli": "./src/cli.ts"
  },
  "scripts": {
    "lint": "oxlint -c ../rg-config/oxlintrc.json -A style -A pedantic -A restriction src tests",
    "type-check": "bun check --noEmit",
    "test": "bun test tests",
    "typecheck": "bun check --noEmit"
  },
  "dependencies": {
    "@rosegriffon/achillea-types": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.5"
  },
  "license": "Apache-2.0",
  "files": [
    "README.md",
    "src",
    "tests",
    "tsconfig.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/rosegriffon.git",
    "directory": "packages/achillea-client"
  },
  "homepage": "https://github.com/aphrody-dev/rosegriffon/tree/main/packages/achillea-client#readme",
  "bugs": {
    "url": "https://github.com/aphrody-dev/rosegriffon/issues"
  }
}
