{
	"name": "@rose-griffon/menu-render",
	"version": "0.1.0",
	"private": true,
	"description": "Renderer React pixel-perfect pour les écrans de menu IEVR depuis un menu-layout.json (canvas 1280×720, sprites G4TX, transforms absolus, z-order drawPriority).",
	"type": "module",
	"main": "src/index.ts",
	"module": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": {
			"bun": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"scripts": {
		"lint": "oxlint -A style -A pedantic -A restriction src",
		"lint:fix": "oxlint -A style -A pedantic -A restriction src --fix",
		"type-check": "tsc --noEmit",
		"demo": "bun src/demo/server.ts",
		"clean": "rm -rf *.tsbuildinfo"
	},
	"peerDependencies": {
		"react": ">=18.0.0",
		"react-dom": ">=18.0.0"
	},
	"devDependencies": {
		"@rose-griffon/iecode-config": "workspace:*",
		"@types/bun": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"oxlint": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"typescript": "catalog:"
	},
	"dependencies": {
		"@rose-griffon/iecode-inagle": "workspace:*",
		"fengari": "catalog:"
	}
}
