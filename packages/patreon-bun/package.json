{
	"name": "@rosegriffon/patreon-bun",
	"version": "1.0.4",
	"description": "Bun-only TypeScript library for the V2 Patreon API. Fork of patreon-api.ts (ghostrider-05) for Rose Griffon.",
	"keywords": [
		"bun",
		"oauth",
		"patreon",
		"patreon-api",
		"patreon-client",
		"patreon-wrapper",
		"typescript",
		"webhook-server"
	],
	"homepage": "https://github.com/aphrody-labs/rosegriffon/tree/main/packages/patreon-bun#readme",
	"bugs": {
		"url": "https://github.com/aphrody-labs/rosegriffon/issues"
	},
	"license": "MIT",
	"author": "Rose Griffon <contact@rose-griffon.fr>",
	"contributors": [
		{
			"name": "ghostrider-05",
			"url": "https://github.com/ghostrider-05"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/aphrody-labs/rosegriffon.git",
		"directory": "packages/patreon-bun"
	},
	"files": [
		"README.md",
		"LICENSE",
		"src"
	],
	"type": "module",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"scripts": {
		"test": "bun test --preload ./src/__tests__/server.ts src",
		"lint": "bun lint -A style -A pedantic -A restriction src",
		"typecheck": "bun check --noEmit",
		"type-check": "bun check --noEmit"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"msw": "catalog:",
		"openapi-types": "catalog:",
		"ts-morph": "catalog:",
		"typescript": "catalog:"
	},
	"engines": {
		"bun": ">=1.4.2"
	}
}
