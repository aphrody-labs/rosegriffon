{
	"name": "@rose-griffon/iecode-inagle",
	"version": "0.1.0",
	"private": true,
	"description": "Accès Bun au vrai inagle (@rose-griffon/inagle) — Game Data API IEVR (parsers cfg.bin/CPK/G4TX) : characters, skills, items, teams, quests, drops, zukan…",
	"type": "module",
	"main": "src/index.ts",
	"module": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": {
			"bun": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./*": {
			"bun": "./src/*",
			"default": "./src/*"
		}
	},
	"scripts": {
		"lint": "oxlint src",
		"lint:fix": "oxlint src --fix",
		"type-check": "tsc --noEmit",
		"test": "bun test",
		"clean": "rm -rf *.tsbuildinfo"
	},
	"dependencies": {
		"@rose-griffon/inagle": "workspace:*",
		"fengari": "catalog:",
		"valibot": "catalog:"
	},
	"devDependencies": {
		"@rose-griffon/iecode-config": "workspace:*",
		"@types/bun": "catalog:",
		"oxlint": "catalog:",
		"typescript": "catalog:"
	}
}
