{
  "name": "@rosegriffon/auth",
  "version": "1.0.0",
	"description": "Shared authentication logic and guards for Rose Griffon apps",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./server": "./src/server.ts",
		"./achillea-session": "./src/achillea-session.ts"
	},
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "type-check": "bun --bun tsc --noEmit",
    "test": "bun test src",
    "lint": "bunx oxlint -c ../../.oxlintrc.json src"
  },
	"dependencies": {
		"@rosegriffon/achillea-core": "workspace:*",
		"@rosegriffon/db": "workspace:*",
    "@rosegriffon/types": "workspace:*",
    "better-auth": "catalog:",
    "zod": "catalog:"
  },
	"devDependencies": {
		"@types/bun": "catalog:",
		"next": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
