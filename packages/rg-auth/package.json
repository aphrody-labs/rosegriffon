{
  "name": "@rosegriffon/auth",
  "version": "1.0.7",
  "private": false,
  "description": "Shared authentication logic and guards for Rose Griffon apps",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./elysia": "./src/elysia.ts",
    "./achillea-session": "./src/achillea-session.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "type-check": "bun --bun tsc --noEmit",
    "test": "bun test src",
    "lint": "oxlint -c ../config/oxlintrc.json src",
    "typecheck": "bun --bun tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/agent-auth": "catalog:",
