    "@rosegriffon/achillea-core": "workspace:*",
    "@rosegriffon/db": "workspace:*",
    "@rosegriffon/types": "workspace:*",
    "better-auth": "catalog:",
    "nodemailer": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/nodemailer": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.3-aphrody.4"
  },
  "license": "UNLICENSED",
  "files": [
    "README.md",
    "src",
    "tsconfig.json",
    "vitest.config.ts"
