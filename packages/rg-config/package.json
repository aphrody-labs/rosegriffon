{
  "name": "@rosegriffon/config",
  "version": "1.4.4",
  "private": false,
  "description": "Configs partagées : TypeScript, bun lint et Tailwind preset",
  "repository": {
    "type": "git",
    "url": "https://github.com/aphrody-dev/rosegriffon.git",
    "directory": "packages/rg-config"
  },
  "files": [
    "README.md",
    "infra.ts",
    "oxlintrc.json",
    "public-urls.ts",
    "tailwind-preset.ts",
    "rg-m3.json",
    "tsconfig-base.json",
    "tsconfig-bun.json",
    "tsconfig-nextjs.json",
    "tsconfig.json"
  ],
  "type": "module",
  "exports": {
    "./infra": "./infra.ts",
    "./public-urls": "./public-urls.ts",
    "./tsconfig-base.json": "./tsconfig-base.json",
    "./tsconfig-nextjs.json": "./tsconfig-nextjs.json",
    "./tsconfig-bun.json": "./tsconfig-bun.json",
    "./oxlintrc.json": "./oxlintrc.json",
    "./tailwind-preset.ts": "./tailwind-preset.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "lint": "oxlint -c ./oxlintrc.json .",
    "typecheck": "bun check --noEmit"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
