{
  "name": "@rosegriffon/config",
  "version": "1.4.4",
  "private": false,
  "description": "Configs partagées : TypeScript, bun lint et Tailwind preset",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/rosegriffon.git",
    "directory": "packages/rg-config"
  },
  "files": [
    "README.md",
    "contract.ts",
    "contract-ffi.ts",
    "contract.generated.ts",
    "infra.ts",
    "rg-urls.ts",
    "oxlintrc.json",
    "tailwind-preset.ts",
    "rg-m3.json",
    "tsconfig-base.json",
    "tsconfig-bun.json",
    "tsconfig-nextjs.json",
    "tsconfig.json"
  ],
  "type": "module",
  "exports": {
    "./contract": "./contract.ts",
    "./contract-ffi": "./contract-ffi.ts",
    "./infra": "./infra.ts",
    "./rg-urls": "./rg-urls.ts",
    "./tsconfig-base.json": "./tsconfig-base.json",
    "./tsconfig-nextjs.json": "./tsconfig-nextjs.json",
    "./tsconfig-bun.json": "./tsconfig-bun.json",
    "./oxlintrc.json": "./oxlintrc.json",
    "./tailwind-preset.ts": "./tailwind-preset.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "contract:sync": "bun scripts/sync-contract.ts",
    "contract:check": "bun scripts/sync-contract.ts --check",
    "lint": "oxlint -c ./oxlintrc.json .",
    "test": "bun test test",
    "typecheck": "bun check --noEmit"
  },
  "engines": {
    "bun": ">=1.4.5"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/aphrody-dev/rosegriffon/tree/main/packages/rg-config#readme",
  "bugs": {
    "url": "https://github.com/aphrody-dev/rosegriffon/issues"
  }
}
