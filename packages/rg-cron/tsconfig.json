{
	"extends": "../config/tsconfig-bun.json",
	"compilerOptions": {
		"outDir": "dist",
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"declaration": false,
		"strict": true,
		"strictNullChecks": true,
		"noImplicitAny": true,
		"noImplicitOverride": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
