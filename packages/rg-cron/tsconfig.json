{
  "extends": "../rg-config/tsconfig-bun.json",
  "compilerOptions": {
    "outDir": "dist",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "declaration": false,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "rootDir": "..",
    "paths": {
      "@rosegriffon/assets": ["../rg-assets/src/index.ts"],
      "@rosegriffon/assets/*": ["../rg-assets/src/*"],
      "@rosegriffon/db": ["../rg-db/src/index.ts"],
      "@rosegriffon/db/*": ["../rg-db/src/*"],
      "@rosegriffon/types": ["../rg-types/src/index.ts"],
      "@rosegriffon/types/*": ["../rg-types/src/*"],
      "@rosegriffon/auth": ["../rg-auth/src/index.ts"],
      "@rosegriffon/auth/*": ["../rg-auth/src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
