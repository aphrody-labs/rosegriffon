{
  "name": "@rosegriffon/cron",
  "version": "1.0.1",
  "description": "Daemon de tâches planifiées (cron) pour la maintenance DB, CDN et API",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "bun test src",
    "start": "bun src/index.ts",
    "qa:website": "bun src/index.ts --run website:qa",
    "build": "bun build src/index.ts --compile --minify --sourcemap --bytecode --format esm --outfile dist/rg-cron",
    "type-check": "bun --bun tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "bunx oxlint -c ../../.oxlintrc.json src"
  },
  "dependencies": {
    "@aphrody-code/x": "catalog:",
    "@asteasolutions/zod-to-openapi": "catalog:",
    "@rosegriffon/auth": "workspace:*",
    "@rosegriffon/assets": "workspace:*",
    "@rosegriffon/db": "workspace:*",
    "@rosegriffon/inagle": "workspace:*",
    "@rosegriffon/types": "workspace:*",
    "cheerio": "catalog:",
    "discord.js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
