{
	"name": "@rose-griffon/cron",
	"version": "0.1.0",
	"description": "Daemon de tâches planifiées (cron) pour la maintenance DB, CDN et API",
	"type": "module",
	"main": "./src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"start": "bun src/index.ts",
		"build": "bun build src/index.ts --compile --minify --sourcemap --bytecode --format esm --outfile dist/rg-cron",
		"type-check": "tsc --noEmit",
		"lint": "bunx oxlint -c ../../.oxlintrc.json src"
	},
	"dependencies": {
		"@aphrody-code/bxc": "catalog:",
		"@aphrody-code/x": "catalog:",
		"@aphrody-code/zukan": "catalog:",
		"@asteasolutions/zod-to-openapi": "catalog:",
		"@rose-griffon/auth": "workspace:*",
		"@rose-griffon/db": "workspace:*",
		"@rose-griffon/inagle": "workspace:*",
		"@rose-griffon/types": "workspace:*",
		"cheerio": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"typescript": "catalog:"
	}
}
