{
  "name": "@rosegriffon/preferences",
  "version": "1.0.6",
  "private": false,
  "description": "Pure cross-runtime resolution of Rose Griffon presentation preferences",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rose-griffon/rg.git",
    "directory": "packages/preferences"
  },
  "files": [
    "src",
    "test",
    "tsconfig.json"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "lint": "oxlint -c ../config/oxlintrc.json src",
    "type-check": "bun --bun tsc --noEmit",
    "test": "bun test test",
    "typecheck": "bun --bun tsc --noEmit"
  },
  "engines": {
    "bun": ">=1.4.3-aphrody.4"
  },
  "license": "UNLICENSED"
}
