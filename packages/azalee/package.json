{
  "name": "@rosegriffon/azalee",
  "version": "1.0.6",
  "private": false,
  "description": "Bibliothèque Bun du wiki Azalée (Inazuma Eleven: Victory Road) — accès PostgreSQL, index CPK, recherche et CLI.",
  "keywords": [
    "azalee",
    "bun",
    "cpk",
    "game-data",
    "ievr",
    "inazuma-eleven",
    "victory-road",
    "wiki"
  ],
  "homepage": "https://azalee.rosegriffon.fr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aphrody-labs/iecode.git",
    "directory": "packages/azalee"
  },
  "bin": {
    "azalee": "./src/cli.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./db": "./src/db/index.ts",
    "./db/*": "./src/db/*.ts",
    "./wiki": "./src/wiki/index.ts",
    "./wiki/*": "./src/wiki/*.ts",
    "./cpk": "./src/cpk/index.ts",
    "./cpk/*": "./src/cpk/*.ts",
    "./game-text": "./src/game-text/index.ts",
    "./game-text/*": "./src/game-text/*.ts",
    "./cross": "./src/cross/index.ts",
    "./cross/*": "./src/cross/*.ts",
    "./images": "./src/images/index.ts",
    "./search": "./src/search/index.ts",
    "./search/*": "./src/search/*.ts",
    "./text": "./src/text/index.ts",
    "./text/*": "./src/text/*.ts",
    "./game": "./src/game/index.ts",
    "./game/*": "./src/game/*.ts",
    "./news": "./src/news/index.ts",
    "./news/*": "./src/news/*.ts",
    "./bot": "./src/bot/index.ts",
    "./bot/*": "./src/bot/*.ts",
    "./remote": "./src/remote/index.ts",
    "./remote/*": "./src/remote/*.ts",
    "./server": "./src/server/index.ts",
    "./server/*": "./src/server/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun --bun tsc -p tsconfig.build.json",
    "cli": "bun src/cli.ts",
    "compile": "bun scripts/build-standalone.ts",
    "serve": "bun src/cli.ts serve",
    "test": "bun test",
    "lint": "bunx oxlint -A style -A pedantic -A restriction src",
    "lint:fix": "bunx oxlint -A style -A pedantic -A restriction --fix src",
    "type-check": "bun --bun tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "bun run build",
    "typecheck": "bun --bun tsc --noEmit"
  },
  "dependencies": {
    "@rosegriffon/assets": "catalog:",
    "@rosegriffon/db": "catalog:",
    "@rosegriffon/inagle": "workspace:*",
    "@rosegriffon/inagle-cross": "workspace:*",
    "commander": "catalog:",
    "wanakana": "catalog:"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
