        "s010201",
        "s010221",
        "s010301"
      ]
    },
    {
      "name": "captain_mark",
      "source_field": "CharacterModelSetMaster.CaptainMarkCode + shape + isHome (CharacterModelKeys.CaptainMark)",
      "address_template": "CharacterParts/Mark/Fbx/m{CaptainMarkCode:D6}/...",
      "asset_kind": "GameObject (captain armband)",
      "verify_regex": "^CharacterParts/Mark/(m\\d{6})",
      "distinct_codes_in_catalog": 2,
      "example_codes": [
        "m000101",
        "m000201"
      ]
    },
    {
      "name": "uniform_number",
      "source_field": "CharacterModelSetMaster.UniformNumberCode + shape + isHome (CharacterModelKeys.UniformNumber)",
      "address_template": "CharacterParts/Number/Fbx/n{UniformNumberCode:D6}/...",
      "asset_kind": "GameObject (jersey number)",
      "verify_regex": "^CharacterParts/Number/(n\\d{6})",
      "distinct_codes_in_catalog": 3,
      "example_codes": [
        "n000101",
        "n900011",
        "n990001"
      ]
    },
    {
      "name": "accessory_legacy",
      "source_field": "CharacterModelSetMaster.AccessoryCodes[] (CharacterModelKeys.Accessory) legacy 6-digit",
      "address_template": "CharacterParts/Accessory/Fbx/i{accessoryCode:D6}.fbx",
      "asset_kind": "GameObject (accessory legacy)",
      "verify_regex": "^CharacterParts/Accessory/Fbx/(i\\d{6})\\.fbx$",
      "distinct_codes_in_catalog": 1,
      "example_codes": [
        "i001001"
      ]
    },
    {
      "name": "accessory_new",
      "source_field": "CharacterModelSetMaster.AccessoryCodes[] new 8-digit",
      "address_template": "CharacterParts/Accessory/i{accessoryCode:D8}/Prefabs/i{accessoryCode:D8}.prefab",
      "asset_kind": "GameObject (accessory new)",
      "verify_regex": "^CharacterParts/Accessory/(i\\d{8})/",
