        "i01001970"
      ]
    },
    {
      "name": "shape_correction",
      "source_field": "CharacterMaster.ShapeCorrectionCode + shape (CharacterModelKeys.ShapeCorrection)",
      "address_template": "CharacterParts/ShapeCorrection/c{shape:D6}_..._{shapeCorrectionCode}...",
      "asset_kind": "ShapeCorrectionClip",
      "verify_regex": "^CharacterParts/ShapeCorrection/(c\\d{6})_",
      "distinct_codes_in_catalog": 4,
      "example_codes": [
