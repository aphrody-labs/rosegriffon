{
  "_meta": {
    "game": "Inazuma Eleven Cross (Unity IL2CPP / Addressables)",
    "source_catalog": "laneB-catalog/locations.ndjson",
    "key_builder_class": "Soccer.CharacterModelKeys (Assembly-CSharp) + Soccer.CharacterModelBuilder",
    "icon_loader": "Soccer.CharacterIconImage.SetByCharacterIconCode / SetByMaster (: AddressableImageLoader)",
    "voice_resolver": "Soccer.Sound.SoundAssetAddressableKeyResolver.ResolveAsAcbAssetKey",
    "address_root": "Addressable address == source path under 'Assets/Addressables/'; internalId = 'Assets/Addressables/<address>'",
    "code_widths": {
      "character_identity (icon/voice/face) ": "c + 8 digits (zero-padded, :D8)",
      "model/skeleton + parts (body/uniform/skin/glove/shoes/mark/number)": "prefix + 6 digits (:D6)"
    },
    "side_suffix": {
      "_H": "Home kit",
      "_A": "Away kit"
    },
    "labels": {
      "Remote": "download-on-demand label",
      "Download": "explicit-download label"
    },
    "shape_enum": "Soccer.Shared.CharacterShape (18 values: MaleAverage=1 .. FemaleLargeThickNeck=18); maps to a 6-digit bodyCode via internal lookup, not a direct zero-pad"
  },
  "patterns": [
    {
      "name": "character_icon",
      "source_field": "CharacterMaster.CharacterIconCode",
      "address_template": "Icons/Character/c{CharacterIconCode:D8}.png",
      "asset_kind": "Texture2D (sprite portrait)",
      "verify_regex": "^Icons/Character/(c\\d{8})\\.png$",
      "distinct_codes_in_catalog": 312,
      "example_codes": [
        "c00001001",
        "c00001002",
        "c00001003",
        "c00001004",
        "c00001005"
      ]
    },
    {
      "name": "character_voice_acb",
      "source_field": "CharacterMaster.VoiceCode",
      "address_template": "Sound/CharacterVoice/c{VoiceCode:D8}.acb",
      "asset_kind": "CriAtomAcbAsset (voice cuesheet)",
      "verify_regex": "^Sound/CharacterVoice/(c\\d{8})\\.acb$",
      "distinct_codes_in_catalog": 246,
      "example_codes": [
        "c00001001",
        "c00001002",
        "c00001003",
        "c00001004",
        "c00001005"
      ]
    },
    {
      "name": "character_voice_awb",
      "source_field": "CharacterMaster.VoiceCode",
      "address_template": "Sound/CharacterVoice/c{VoiceCode:D8}.awb",
      "asset_kind": "CriAtomAwbAsset (voice streaming)",
      "verify_regex": "^Sound/CharacterVoice/(c\\d{8})\\.awb$",
      "distinct_codes_in_catalog": 101,
      "example_codes": [
        "c00001001",
        "c00001002",
        "c00001003",
        "c00001004",
        "c00001005"
      ]
    },
    {
      "name": "character_voice_internalid",
      "source_field": "CharacterMaster.VoiceCode (CRI bundle internal id, lowercased)",
      "address_template": "app_sounds_assets_sound/charactervoice/c{VoiceCode:D8}.acb_data",
      "asset_kind": "CRI internal id",
      "verify_regex": "^app_sounds_assets_sound/charactervoice/(c\\d{8})\\.acb_data$",
      "distinct_codes_in_catalog": 3,
      "example_codes": [
        "c00001001",
        "c00003001",
        "c00003021"
      ]
    },
    {
      "name": "face_ingame",
      "source_field": "CharacterMaster.FaceCode  (CharacterModelKeys.Face)",
      "address_template": "CharacterParts/Face/c{FaceCode:D8}/Prefabs/c{FaceCode:D8}.prefab",
      "asset_kind": "GameObject (in-game face rig)",
      "verify_regex": "^CharacterParts/Face/(c\\d{8})/",
      "distinct_codes_in_catalog": 254,
      "example_codes": [
        "c01000010",
        "c01000020",
        "c01000030",
        "c01000040",
        "c01000050"
      ]
    },
    {
      "name": "face_director",
      "source_field": "CharacterMaster.FaceCode (cutscene/skit)",
      "address_template": "DirectorParts/Face/c{FaceCode:D8}/Prefabs/face_c{FaceCode:D8}.prefab",
      "asset_kind": "GameObject (director/skit face)",
      "verify_regex": "^DirectorParts/Face/(c\\d{8})/",
      "distinct_codes_in_catalog": 105,
      "example_codes": [
        "c01002610",
        "c01002640",
        "c02029500",
        "c05020110",
        "c05020280"
      ]
    },
    {
      "name": "base_body",
      "source_field": "CharacterShape -> bodyCode lookup (CharacterModelKeys.BaseBone); NOT a :D6 of the enum value (enum 1..18, codes 000101/000201/000301/000401)",
      "address_template": "CharacterParts/Base/Fbx/c{bodyCode:D6}.fbx",
      "asset_kind": "GameObject (shared skeleton mesh)",
      "verify_regex": "^CharacterParts/Base/Fbx/(c\\d{6})\\.fbx$",
      "distinct_codes_in_catalog": 4,
      "example_codes": [
        "c000101",
        "c000201",
        "c000301",
        "c000401"
      ]
    },
    {
      "name": "motions",
      "source_field": "Shared by skeleton/bodyCode (same lookup as base_body)",
      "address_template": "Motions/Battle/c{bodyCode:D6}/c{bodyCode:D6}_p010_..._<anim>.fbx",
      "asset_kind": "AnimationClip",
      "verify_regex": "^Motions/Battle/(c\\d{6})/",
      "distinct_codes_in_catalog": 4,
      "example_codes": [
        "c000101",
        "c000201",
        "c000301",
        "c000401"
      ]
    },
    {
      "name": "uniform_mesh",
      "source_field": "CharacterModelSetMaster.UniformCode + shape (CharacterModelKeys.Uniform)",
      "address_template": "CharacterParts/Uniform/Fbx/u{group:D4}{shape:D2}/u{group:D4}{shape:D2}.fbx",
      "asset_kind": "GameObject (uniform mesh per shape)",
      "verify_regex": "^CharacterParts/Uniform/Fbx/(u\\d{6})/",
      "distinct_codes_in_catalog": 44,
      "example_codes": [
        "u000101",
        "u000201",
        "u000301",
        "u000401",
        "u000501"
      ]
    },
    {
      "name": "uniform_material",
      "source_field": "CharacterModelSetMaster.UniformCode + shape + isHome",
      "address_template": "CharacterParts/Uniform/u{variant:D7}/u{variant:D7}_{H|A}/...",
      "asset_kind": "Material/Texture (kit color, Home=_H Away=_A)",
      "verify_regex": "^CharacterParts/Uniform/(u\\d{7})/",
      "distinct_codes_in_catalog": 92,
      "example_codes": [
        "u0101010",
        "u0101011",
        "u0101310",
        "u0102010",
        "u0102011"
      ]
    },
    {
      "name": "skin",
      "source_field": "CharacterModelSetMaster.SkinCode + shape (CharacterModelKeys.Skin)",
      "address_template": "CharacterParts/Skin/Fbx/sk{SkinCode:D6}/...",
      "asset_kind": "GameObject/Material (skin/body)",
      "verify_regex": "^CharacterParts/Skin/(sk\\d{6})",
      "distinct_codes_in_catalog": 4,
      "example_codes": [
        "sk000101",
        "sk000201",
        "sk000301",
        "sk000501"
      ]
    },
    {
      "name": "glove",
      "source_field": "CharacterModelSetMaster.GloveCode + shape + isHome (CharacterModelKeys.Glove)",
      "address_template": "CharacterParts/Glove/Fbx/g{GloveCode:D6}/...",
      "asset_kind": "GameObject (GK glove)",
      "verify_regex": "^CharacterParts/Glove/(g\\d{6})",
      "distinct_codes_in_catalog": 24,
      "example_codes": [
        "g010101",
        "g010201",
        "g010301",
        "g010401",
        "g010501"
      ]
    },
    {
      "name": "shoes",
      "source_field": "CharacterModelSetMaster.ShoesCode + shape + isHome (CharacterModelKeys.Shoes)",
      "address_template": "CharacterParts/Shoes/Fbx/s{ShoesCode:D6}/...",
      "asset_kind": "GameObject (shoes)",
      "verify_regex": "^CharacterParts/Shoes/(s\\d{6})",
      "distinct_codes_in_catalog": 36,
      "example_codes": [
        "s010101",
