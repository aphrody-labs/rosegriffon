{
	"extends": "@rose-griffon/config/tsconfig-bun.json",
	"compilerOptions": {
		"baseUrl": ".",
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"useDefineForClassFields": false,
		"paths": {
			"@/*": ["./src/*"],
			"@rose-griffon/db": ["../../packages/db/src/index.ts"],
			"@rose-griffon/db/*": ["../../packages/db/src/*"],
			"@rose-griffon/types": ["../../packages/types/src/index.ts"],
			"@rose-griffon/types/*": ["../../packages/types/src/*"],
			"@rose-griffon/auth": ["../../packages/auth/src/index.ts"],
			"@rose-griffon/auth/*": ["../../packages/auth/src/*"]
		},
		"outDir": "dist",
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"moduleDetection": "force"
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
