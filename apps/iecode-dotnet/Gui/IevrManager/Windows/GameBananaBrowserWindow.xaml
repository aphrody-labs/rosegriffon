<Window x:Class="IEVRModManager.Windows.GameBananaBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameBanana Mods"
        Height="720" Width="1200"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="RefreshButton"
                    Grid.Column="0"
                    Content="⟳ Refresh"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Refresh_Click"
                    Width="130"
                    Margin="0,0,8,0"/>
            <TextBlock x:Name="SearchLabel"
                       Grid.Column="1"
                       Text="Search"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="6,0,6,0"/>
            <TextBox x:Name="SearchBox"
                     Grid.Column="2"
                     Width="260"
                     Margin="0,0,12,0"
                     TextChanged="SearchBox_TextChanged"/>
            <TextBlock x:Name="StatusText"
                       Grid.Column="3"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextBrush}"
                       FontWeight="Bold"
                       Text="Loading mods..."/>
        </Grid>

        <ListBox x:Name="ModsList"
                 Grid.Row="1"
                 SelectionMode="Single"
                 MouseDoubleClick="ModsList_MouseDoubleClick"
                 BorderThickness="0"
                 Background="{DynamicResource BgBrush}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Card" Background="Transparent" CornerRadius="8">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource FocusBgBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource SelectedBgBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel IsItemsHost="True" Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="6"
                            Padding="8"
                            Width="260"
                            Height="240"
                            Background="{DynamicResource BgBrush}"
                            Cursor="Hand">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel x:Name="ContentPanel" Grid.RowSpan="4">
                                <Border Height="140" 
                                        Background="{DynamicResource TrackBrush}"
                                        CornerRadius="4"
                                        Margin="0,0,0,6">
                                    <Image x:Name="ModImage"
                                           Source="{Binding ThumbnailUrl}"
                                           Height="140"
                                           Stretch="UniformToFill"
                                           ImageFailed="ModImage_ImageFailed"/>
                                </Border>
                                <TextBlock Text="{Binding Name}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="22"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrightBrush}"
                                           Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Stretch">
                                    <Button Content="Open"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Tag="{Binding}"
                                            Click="OpenPage_Click"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Margin="0,0,6,0"
                                            MinWidth="100"/>
                                    <Button Content="Download"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Tag="{Binding}"
                                            Click="DownloadRow_Click"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Margin="6,0,0,0"
                                            MinWidth="100"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="SkeletonPanel" Visibility="Collapsed" Grid.RowSpan="4">
                                <Rectangle Height="140"
                                           RadiusX="4"
                                           RadiusY="4"
                                           Fill="{DynamicResource TrackBrush}"
                                           Margin="0,0,0,6"/>
                                <Rectangle Height="16"
                                           Fill="{DynamicResource TrackBrush}"
                                           RadiusX="3"
                                           RadiusY="3"
                                           Margin="0,0,0,6"/>
                                <Rectangle Height="34"
                                           Fill="{DynamicResource TrackBrush}"
                                           RadiusX="4"
                                           RadiusY="4"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                            <Setter TargetName="ContentPanel" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="SkeletonPanel" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterText"
                       Grid.Column="0"
                       Text="Double click opens the mod page."
                       Foreground="{DynamicResource TextBrush}"
                       Loaded="FooterText_Loaded"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PrevPageButton"
                        Content="Previous"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="110"
                        Margin="0,0,8,0"
                        Click="PrevPage_Click"/>
                <TextBlock x:Name="PageIndicator"
                           Text="Page 1"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,8,0"/>
                <Button x:Name="NextPageButton"
                        Content="Next"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="110"
                        Click="NextPage_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
