<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>IECODE.Ffi</AssemblyName>
    <RootNamespace>IECODE.Ffi</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NativeLib Condition="'$(PublishAot)' == 'true'">Shared</NativeLib>
    <IsPackable>true</IsPackable>
    <PackageId>iecode-ffi-dotnet</PackageId>
    <Description>.NET 10 adapter for the IECODE native FFI and Node API hosts.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Core/IECODE.Core.csproj" />
    <PackageReference Include="Microsoft.JavaScript.NodeApi" />
    <PackageReference Include="Microsoft.JavaScript.NodeApi.DotNetHost" />
  </ItemGroup>
</Project>
