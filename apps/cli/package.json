{
  "name": "@rosegriffon/cli",
  "version": "1.4.8",
  "private": true,
  "description": "Unified Bun CLI for Rose Griffon & Inazuma Eleven monorepo",
  "type": "module",
  "bin": {
    "ie": "./src/index.ts",
    "rg": "./src/index.ts",
    "rosegriffon": "./src/index.ts"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --target=bun --outdir=./dist",
    "lint": "oxlint src",
    "typecheck": "bun check --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@rosegriffon/inagle": "workspace:*",
    "@rosegriffon/azalee": "workspace:*",
    "@rosegriffon/achillea-contract": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
