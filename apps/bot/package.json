{
	"name": "@rg/bot",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Bot Discord Rose Griffon \u2014 slash commands public + admin, sync members, canvas cards",
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"start": "bun src/index.ts",
		"build": "bun build src/index.ts --target=bun --outdir=dist",
		"type-check": "tsc --noEmit",
		"lint": "oxlint src",
		"lint:fix": "oxlint --fix src",
		"test": "vitest run",
		"smoke:admin": "bun src/scripts/smoke-admin.ts",
		"smoke:canvas": "bun src/scripts/smoke-canvas.ts"
	},
	"dependencies": {
		"@aphrody-code/canvas": "0.1.99-fork.4",
		"@rg/db": "workspace:*",
		"@rg/types": "workspace:*",
		"@rpbey/discordx": "catalog:",
		"@supabase/supabase-js": "catalog:",
		"discord.js": "catalog:",
		"reflect-metadata": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@rg/config": "workspace:*",
		"@types/bun": "catalog:",
		"oxlint": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"bun": ">=1.3.14"
	}
}
