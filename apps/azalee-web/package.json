{
  "name": "@rosegriffon/azalee-web",
  "version": "1.4.4",
  "private": true,
  "scripts": {
    "dev": "bun --smol --bun node_modules/next/dist/bin/next dev --turbopack",
    "build": "bun ../../scripts/next-build.ts",
    "start": "bun --bun node_modules/next/dist/bin/next start",
    "lint": "bun lint -A style -A pedantic -A restriction -A react/react-in-jsx-scope -A unicorn/consistent-function-scoping -A promise/no-multiple-resolved -A react-perf .",
    "lint:fix": "bun lint -A style -A pedantic -A restriction -A react/react-in-jsx-scope -A unicorn/consistent-function-scoping -A promise/no-multiple-resolved -A react-perf --fix .",
    "format": "bun fmt .",
    "format:check": "bun fmt --check .",
    "type-check": "bun check --noEmit",
    "test": "bun test app lib src tests",
    "test:run": "bun --bun vitest run",
    "create-draft": "bun scripts/create-draft.ts",
    "backup:supabase": "bun scripts/ops/backup-supabase-to-sqlite.ts",
    "sync:supabase": "bun scripts/ops/sync-supabase-to-sqlite.ts",
    "sync:full": "bun scripts/ops/sync-supabase-to-sqlite.ts --full --deletes",
    "typecheck": "bun check -p tsconfig.json --noEmit"
  },
  "dependencies": {
