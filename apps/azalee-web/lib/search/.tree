## Import Map

```typescript
// From components
import { GlobalSearch } from "@/components/wiki/GlobalSearch";
import { SearchResultHighlight } from "@/components/wiki/SearchResultHighlight";

// From server actions
import { searchGlobal, getSearchSuggestions } from "@/app/actions/search";
import type { EnhancedSearchResult } from "@/app/actions/search";

// From lib/search (unified exports)
import {
  // Fuzzy matching
  levenshteinDistance,
  similarityScore,
  isSimilar,
  normalizeText,
  findClosestMatch,
  getNameVariations,
  detectMatchedLanguage,
  highlightMatches,

  // Smart search
  smartSearch,
  clearSearchCache,
  getCacheStats,

  // Types
  type SmartSearchResult,
  type SmartSearchConfig,
  type SearchContext,
} from "@/lib/search";
```

