{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": "nextjs",
	"bunVersion": "1.x",
	"installCommand": "cd ../.. && bun install --no-save --frozen-lockfile",
	"ignoreCommand": "cd ../.. && npx turbo-ignore @rose-griffon/azalee",
	"buildCommand": "cd ../.. && turbo run build --filter=@rose-griffon/azalee... --cache=remote:rw",
	"env": {
		"NEXT_PUBLIC_SUPABASE_URL": "https://isbkaeltubqittywibeh.supabase.co"
	},
	"outputDirectory": ".next"
}
