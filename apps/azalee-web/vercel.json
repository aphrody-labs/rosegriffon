{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": "nextjs",
	"installCommand": "cd ../.. && bun install --no-save --frozen-lockfile",
	"ignoreCommand": "cd ../.. && npx turbo-ignore @rosegriffon/azalee",
	"buildCommand": "cd ../.. && turbo run build --filter=@rosegriffon/azalee... --cache=remote:rw",
	"outputDirectory": ".next"
}
