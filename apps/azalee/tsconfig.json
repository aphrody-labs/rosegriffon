{
	"extends": "@rose-griffon/config/tsconfig-nextjs.json",
	"compilerOptions": {
		"noImplicitOverride": false,
		"noUncheckedIndexedAccess": false,
		"target": "ES2022",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"paths": {
			"@/*": ["./src/*", "./*"]
		},
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		]
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts",
		"**/*.mts"
	],
	"exclude": ["node_modules", ".next", "dist", ".turbo", "scripts"]
}
