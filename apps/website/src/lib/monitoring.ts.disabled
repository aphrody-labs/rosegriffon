import { createClient } from "@/lib/supabase/server";
import { edgeCacheMonitor } from "@/lib/edge-cache";

// Types pour monitoring
interface PerformanceMetric {
  id?: string;
  timestamp: Date;
  endpoint: string;
  method: string;
  duration: number;
  cache_hit: boolean;
  user_id?: string;
  ip_address: string;
  user_agent?: string;
  status_code: number;
  error_message?: string;
  request_size?: number;
  response_size?: number;
}

interface AlertConfig {
  type: "slow_query" | "cache_miss_high" | "error_rate_high" | "memory_high";
  threshold: number;
  severity: "low" | "medium" | "high" | "critical";
  channels: ("console" | "webhook" | "database" | "email")[];
}

class PerformanceMonitor {
  private metrics: PerformanceMetric[] = [];
  private slowQueryThreshold = 1000; // 1 seconde
  private cacheMissThreshold = 80; // 80% hit rate minimum
  private errorRateThreshold = 5; // 5% erreurs maximum
  private memoryThreshold = 512 * 1024 * 1024; // 512MB

  private alertConfigs: AlertConfig[] = [
    {
      type: "slow_query",
      threshold: 1000,
      severity: "medium",
      channels: ["console", "webhook"],
    },
    {
      type: "cache_miss_high",
      threshold: 80,
      severity: "medium",
      channels: ["console", "database"],
    },
    {
      type: "error_rate_high",
      threshold: 5,
      severity: "high",
      channels: ["console", "webhook", "database"],
    },
    {
      type: "memory_high",
      threshold: 512 * 1024 * 1024,
      severity: "critical",
      channels: ["console", "webhook", "database", "email"],
    },
  ];

  // Logger requêtes lentes avec détails enrichis
  async logSlowQuery(
    endpoint: string,
    duration: number,
    details: Record<string, any> = {}
  ) {
    if (duration > this.slowQueryThreshold) {
      const slowQueryData = {
        endpoint,
        duration,
        threshold: this.slowQueryThreshold,
        severity:
          duration > 5000 ? "critical" : duration > 2000 ? "high" : "medium",
        ...details,
      };

      console.warn(
        `🐌 Slow query detected: ${endpoint} (${duration}ms)`,
        slowQueryData
      );

      // Envoyer alerte selon configuration
      await this.sendAlert("slow_query", slowQueryData);

      // Analyser la cause si très lent
      if (duration > 5000) {
        await this.analyzeSlowQuery(endpoint, details);
      }
    }
  }

  // Analyser les causes de lenteur
  private async analyzeSlowQuery(endpoint: string, details: any) {
    const analysis = {
      endpoint,
      possibleCauses: [],
      recommendations: [],
    };

    // Analyse des patterns courants
    if (details.queryCount > 10) {
      analysis.possibleCauses.push("N+1 query problem");
      analysis.recommendations.push("Implement query batching");
    }

    if (details.cacheHit === false) {
      analysis.possibleCauses.push("Cache miss");
      analysis.recommendations.push("Improve caching strategy");
    }

    if (details.dataSize > 1024 * 1024) {
      // > 1MB
      analysis.possibleCauses.push("Large data transfer");
      analysis.recommendations.push("Implement pagination or data filtering");
    }

    console.info("🔍 Slow query analysis:", analysis);

    // Stocker l'analyse pour review
    await this.storeAnalysis(analysis);
  }

  // Tracker performance cache avec métriques détaillées
  async trackCachePerformance(key: string, hit: boolean, duration?: number) {
    const cacheStats = await this.getCacheStats();

    if (cacheStats.hitRate < this.cacheMissThreshold) {
      const alertData = {
        key,
        hitRate: cacheStats.hitRate,
        threshold: this.cacheMissThreshold,
        total: cacheStats.total,
        hits: cacheStats.hits,
        misses: cacheStats.misses,
        avgDuration: duration,
      };

      console.warn(
        `📉 Low cache hit rate: ${cacheStats.hitRate}% for ${key}`,
        alertData
      );
      await this.sendAlert("cache_miss_high", alertData);
    }

    // Tracker dans edge cache monitor
    if (hit) {
      edgeCacheMonitor.recordHit(key);
    } else {
      edgeCacheMonitor.recordMiss(key);
    }
  }

  // Métriques temps réel avec historique
  async getCacheStats(timeRange: "hour" | "day" | "week" = "hour") {
    const ranges = {
      hour: 60 * 60 * 1000,
      day: 24 * 60 * 60 * 1000,
      week: 7 * 24 * 60 * 60 * 1000,
    };

    const cutoff = new Date(Date.now() - ranges[timeRange]);
    const recentMetrics = this.metrics.filter((m) => m.timestamp > cutoff);

    const total = recentMetrics.length;
    const hits = recentMetrics.filter((m) => m.cache_hit).length;
    const avgDuration =
      total > 0
        ? recentMetrics.reduce((sum, m) => sum + m.duration, 0) / total
        : 0;

    const errorRate =
      total > 0
        ? (recentMetrics.filter((m) => m.status_code >= 400).length / total) *
          100
        : 0;

    return {
      total,
      hits,
      misses: total - hits,
      hitRate: total > 0 ? (hits / total) * 100 : 0,
      avgDuration: Math.round(avgDuration),
      errorRate: Math.round(errorRate * 100) / 100,
      timeRange,
    };
  }

  // Surveillance mémoire et ressources
  async monitorSystemResources() {
    const memUsage = process.memoryUsage();
    const cpuUsage = process.cpuUsage();

    const metrics = {
      memory: {
        used: memUsage.heapUsed,
        total: memUsage.heapTotal,
        percentage: (memUsage.heapUsed / memUsage.heapTotal) * 100,
      },
      cpu: cpuUsage,
      uptime: process.uptime(),
      timestamp: new Date(),
    };

    // Alerter si mémoire élevée
    if (memUsage.heapUsed > this.memoryThreshold) {
      await this.sendAlert("memory_high", {
        current: memUsage.heapUsed,
        threshold: this.memoryThreshold,
        percentage: metrics.memory.percentage,
        uptime: metrics.uptime,
      });
    }

    return metrics;
  }

  // Envoyer alertes multi-canal
  private async sendAlert(type: AlertConfig["type"], data: any) {
    const config = this.alertConfigs.find((c) => c.type === type);
    if (!config) return;

    const alert = {
      type,
      severity: config.severity,
      data,
      timestamp: new Date().toISOString(),
      environment: process.env.NODE_ENV,
      region: process.env.VERCEL_REGION,
    };

    // Envoyer selon les canaux configurés
    for (const channel of config.channels) {
      await this.sendToChannel(channel, alert);
    }
  }

  private async sendToChannel(channel: string, alert: any) {
    try {
      switch (channel) {
        case "console":
          console.error(
            `🚨 [${alert.severity.toUpperCase()}] ${alert.type}:`,
            alert.data
          );
          break;

        case "webhook":
          if (process.env.MONITORING_WEBHOOK_URL) {
            await fetch(process.env.MONITORING_WEBHOOK_URL, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(alert),
            });
          }
          break;

        case "database":
          const supabase = await createClient();
          await supabase.from("performance_alerts").insert({
            type: alert.type,
            severity: alert.severity,
            data: alert.data,
            created_at: alert.timestamp,
          });
          break;

        case "email":
          if (alert.severity === "critical") {
            await this.sendCriticalEmail(alert);
          }
          break;
      }
    } catch (error) {
      console.error(`Failed to send alert to ${channel}:`, error);
    }
  }

  private async sendCriticalEmail(alert: any) {
    // Implémentation email pour alertes critiques
    // Utiliser le service email existant (Nodemailer, etc.)
    console.error("🚨 CRITICAL ALERT - Email notification needed:", alert);
  }

  // Middleware pour tracker automatiquement toutes les requêtes
  async trackRequest(
    endpoint: string,
    method: string,
    startTime: number,
    cacheHit: boolean,
    statusCode: number,
    options: {
      userId?: string;
      ipAddress?: string;
      userAgent?: string;
      requestSize?: number;
      responseSize?: number;
      error?: string;
    } = {}
  ) {
    const duration = Date.now() - startTime;

    const metric: PerformanceMetric = {
      timestamp: new Date(),
      endpoint,
      method,
      duration,
      cache_hit: cacheHit,
      status_code: statusCode,
      ip_address: options.ipAddress || "unknown",
      user_id: options.userId,
      user_agent: options.userAgent,
      request_size: options.requestSize,
      response_size: options.responseSize,
      error_message: options.error,
    };

    this.metrics.push(metric);

    // Nettoyer les vieilles métriques (garder 24h en mémoire)
    const dayAgo = new Date(Date.now() - 24 * 60 * 60 * 1000);
    this.metrics = this.metrics.filter((m) => m.timestamp > dayAgo);

    // Stocker en DB les métriques importantes
    if (statusCode >= 400 || duration > 1000 || !cacheHit) {
      await this.storeMetric(metric);
    }

    // Analyser les métriques
    await this.logSlowQuery(endpoint, duration, {
      method,
      statusCode,
      cacheHit,
      userId: options.userId,
    });

    await this.trackCachePerformance(endpoint, cacheHit, duration);
  }

  private async storeMetric(metric: PerformanceMetric) {
    try {
      const supabase = await createClient();
      await supabase.from("performance_metrics").insert({
        endpoint: metric.endpoint,
        method: metric.method,
        duration: metric.duration,
        cache_hit: metric.cache_hit,
        status_code: metric.status_code,
        user_id: metric.user_id,
        ip_address: metric.ip_address,
        created_at: metric.timestamp.toISOString(),
        error_message: metric.error_message,
      });
    } catch (error) {
      console.error("Failed to store performance metric:", error);
    }
  }

  private async storeAnalysis(analysis: any) {
    try {
      const supabase = await createClient();
      await supabase.from("performance_analysis").insert({
        type: "slow_query_analysis",
        data: analysis,
        created_at: new Date().toISOString(),
      });
    } catch (error) {
      console.error("Failed to store analysis:", error);
    }
  }

  // Rapport de performance périodique
  async generatePerformanceReport(period: "daily" | "weekly" = "daily") {
    const stats = await this.getCacheStats(period === "daily" ? "day" : "week");
    const systemMetrics = await this.monitorSystemResources();
    const edgeStats = edgeCacheMonitor.getStats();

    const report = {
      period,
      timestamp: new Date().toISOString(),
      cache: stats,
      edge: edgeStats,
      system: systemMetrics,
      summary: {
        status: this.getOverallStatus(stats, systemMetrics),
        recommendations: this.generateRecommendations(stats, systemMetrics),
      },
    };

    console.info(`📊 Performance Report (${period}):`, report);

    // Stocker le rapport
    try {
      const supabase = await createClient();
      await supabase.from("performance_reports").insert({
        period,
        data: report,
        created_at: report.timestamp,
      });
    } catch (error) {
      console.error("Failed to store performance report:", error);
    }

    return report;
  }

  private getOverallStatus(cacheStats: any, systemMetrics: any) {
    if (
      cacheStats.hitRate < 70 ||
      cacheStats.errorRate > 10 ||
      systemMetrics.memory.percentage > 90
    ) {
      return "critical";
    }
    if (
      cacheStats.hitRate < 80 ||
      cacheStats.errorRate > 5 ||
      systemMetrics.memory.percentage > 80
    ) {
      return "warning";
    }
    return "healthy";
  }

  private generateRecommendations(cacheStats: any, systemMetrics: any) {
    const recommendations = [];

    if (cacheStats.hitRate < 80) {
      recommendations.push(
        "Improve caching strategy - current hit rate is low"
      );
    }

    if (cacheStats.avgDuration > 500) {
      recommendations.push(
        "Optimize slow endpoints - average response time is high"
      );
    }

    if (systemMetrics.memory.percentage > 80) {
      recommendations.push("Monitor memory usage - approaching limits");
    }

    if (cacheStats.errorRate > 3) {
      recommendations.push(
        "Investigate error sources - error rate is elevated"
      );
    }

    return recommendations;
  }
}

export const performanceMonitor = new PerformanceMonitor();

// Helper pour instrumenter automatiquement les fonctions
export function withPerformanceTracking<
  T extends (...args: any[]) => Promise<any>,
>(fn: T, name: string): T {
  return (async (...args: any[]) => {
    const startTime = Date.now();
    let error: Error | undefined;
    let result: any;

    try {
      result = await fn(...args);
      return result;
    } catch (e) {
      error = e as Error;
      throw e;
    } finally {
      const duration = Date.now() - startTime;
      await performanceMonitor.trackRequest(
        name,
        "FUNCTION",
        startTime,
        false, // Les fonctions ne sont pas mises en cache
        error ? 500 : 200,
        { error: error?.message }
      );
    }
  }) as T;
}
