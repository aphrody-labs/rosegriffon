{
	"extends": "@rose-griffon/config/tsconfig-nextjs.json",
	"compilerOptions": {
		"baseUrl": ".",
		"types": ["google.maps", "bun"],
		"tsBuildInfoFile": ".next/.tsbuildinfo",
		"paths": {
			"@/*": ["./src/*"],
			"@public/*": ["./public/*"],
			"@rose-griffon/db": ["../../packages/db/src/index.ts"],
			"@rose-griffon/db/*": ["../../packages/db/src/*"],
			"@rose-griffon/types": ["../../packages/types/src/index.ts"],
			"@rose-griffon/types/*": ["../../packages/types/src/*"],
			"@rose-griffon/auth": ["../../packages/auth/src/index.ts"],
			"@rose-griffon/auth/*": ["../../packages/auth/src/*"],
			"@rose-griffon/ui": ["../../packages/ui/src/index.ts"],
			"@rose-griffon/ui/*": ["../../packages/ui/src/*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts"
	],
	"exclude": ["node_modules", ".next", "dist", "build", "out", "coverage", ".turbo"]
}
