{
	"extends": "@rose-griffon/config/tsconfig-nextjs.json",
	"compilerOptions": {
		"baseUrl": ".",
		"types": ["google.maps", "bun"],
		"tsBuildInfoFile": ".next/.tsbuildinfo",
		"paths": {
			"@/*": ["./src/*"],
			"@public/*": ["./public/*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts"
	],
	"exclude": [
		"node_modules",
		".next",
		"dist",
		"build",
		"out",
		"coverage",
		".turbo"
	]
}
