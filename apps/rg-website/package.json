		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"analyze": "ANALYZE=true next build",
		"type-check": "tsc --noEmit",
		"clean": "rm -rf .next .turbo dist",
		"pre-deploy": "bun scripts/pre-deploy-check.js",
		"submit-sitemap": "bun scripts/submit-sitemap.js",
		"supabase:types": "supabase gen types typescript --project-id isbkaeltubqittywibeh > src/types/supabase.ts"
