{
	"name": "@rose-griffon/website",
	"version": "1.4.0",
	"private": true,
	"scripts": {
		"dev": "bun run --bun next dev",
		"test": "bun test src",
		"test:ui": "vitest --ui",
		"test:run": "vitest run",
		"build": "bash ../../scripts/next-build.sh",
		"start": "bun run --bun next start",
		"lint": "oxlint -A style -A pedantic -A restriction -A react/react-in-jsx-scope -A unicorn/consistent-function-scoping -A promise/no-multiple-resolved -A react-perf . && eslint .",
