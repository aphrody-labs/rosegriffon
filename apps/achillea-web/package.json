{
  "name": "@rosegriffon/achillea-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "config:generate": "bun scripts/inject-env.ts",
    "start": "bun run config:generate && ng serve",
    "dev": "bun run start",
    "build": "bun run config:generate && ng build && bun scripts/sanitize-production-artifact.ts",
    "watch": "bun run config:generate && ng build --watch --configuration development",
    "test": "bun test tests/",
    "test:angular": "ng test --watch=false",
    "test:e2e": "bun test ./tests/e2e/smoke.e2e.ts",
    "lint": "bun --cwd ../.. ./node_modules/.bin/oxlint --config .oxlintrc.json apps/achillea-web",
    "lint:fix": "bun --cwd ../.. ./node_modules/.bin/oxlint --config .oxlintrc.json --fix apps/achillea-web",
    "type-check": "tsc -p tsconfig.typecheck.json",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "clean": "bun scripts/clean.ts"
  },
  "dependencies": {
    "@angular/common": "^21.2.16",
    "@angular/compiler": "^21.2.16",
    "@angular/core": "^21.2.16",
    "@angular/forms": "^21.2.16",
    "@angular/platform-browser": "^21.2.16",
    "@angular/router": "^21.2.16",
    "@casl/ability": "catalog:",
    "@colyseus/sdk": "^0.17.42",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@primeuix/themes": "^2.0.3",
    "@rosegriffon/achillea-client": "workspace:*",
    "@rosegriffon/achillea-core": "workspace:*",
    "@rosegriffon/achillea-types": "workspace:*",
    "@sindresorhus/transliterate": "catalog:",
    "@supabase/supabase-js": "^2.107.0",
    "@tailwindcss/postcss": "^4.3.0",
    "brackets-model": "catalog:",
    "brackets-viewer": "^1.9.1",
    "iso-639-1": "^3.1.5",
    "lottie-web": "^5.13.0",
    "ngx-lottie": "^21.2.0",
    "primeicons": "^7.0.0",
    "primelocale": "^2.3.2",
    "primeng": "^21.1.9",
    "rxjs": "catalog:",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.8.1",
    "valibot": "^1.4.1",
    "vite": "^8.0.16",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^21.2.14",
    "@angular/cli": "^21.2.14",
    "@angular/compiler-cli": "^21.2.16",
    "@happy-dom/global-registrator": "^20.10.1",
    "@types/jasmine": "~6.0.0",
    "jasmine-core": "~6.2.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "postcss": "^8.5.15",
    "puppeteer": "^25.1.0",
    "tailwindcss-primeui": "^0.6.1",
    "typescript": "catalog:"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  }
}
