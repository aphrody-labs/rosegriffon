/* Config dédiée au `type-check` (tsc --noEmit). Distincte de tsconfig.app.json
 * (utilisé par le build @angular/build) pour ne pas impacter le build : ici on
 * fixe rootDir à la racine du monorepo afin que @achillea/types — consommé EN
 * SOURCE via le path mapping — ne déclenche pas TS6059 (« not under rootDir »). */
{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"rootDir": "../.."
	},
	"include": ["src/**/*.ts"],
	"exclude": ["src/**/*.spec.ts"]
}
