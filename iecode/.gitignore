bin/
obj/
*.user

# IECODE extracted data (gros, non versionné)
data/
dump/
out/

# Node / Bun / Turbo
node_modules/
.turbo/
dist/
build/
*.tsbuildinfo

# Test coverage
coverage/
*.lcov

# Caches lint/format
