{
	"name": "iecode",
	"version": "0.1.0",
	"devDependencies": {
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"turbo": "catalog:"
	},
	"description": "IECODE — toolkit IEVR (C# .NET 10) + pont JS/Bun via node-api-dotnet. Monorepo Turbo + Bun workspaces.",
	"engines": {
		"bun": ">=1.4.0"
	},
	"packageManager": "bun@1.4.0",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint:fix",
		"type-check": "turbo run type-check",
		"test": "turbo run test",
		"clean": "turbo run clean && rm -rf node_modules .turbo",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"dotnet:build": "dotnet build IECODE.sln -c Release",
		"dotnet:test": "dotnet test IECODE.sln -c Release",
		"napi:build": "dotnet build vendor/node-api-dotnet/NodeApi.sln -c Release",
		"sync:gamedata": "bun scripts/sync-gamedata.ts",
		"scrape": "bun packages/steam-sync/src/cli.ts",
		"steam:sync": "bun packages/steam-sync/src/cli.ts",
		"steam:depots": "bun packages/steam-sync/src/cli.ts --list",
		"data:accumulate": "bun packages/pipeline/src/cli.ts accumulate",
		"data:export": "bun packages/pipeline/src/cli.ts export",
		"data:serve": "bun packages/pipeline/src/cli.ts serve"
	},
	"type": "module"
}
