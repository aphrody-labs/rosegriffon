{
	"name": "@rose-griffon/iecode-steam-sync",
	"version": "0.1.0",
	"private": true,
	"description": "Sync IEVR depuis Steam : scraper store dédié (via le package bxc) + download/extraction natifs (@rose-griffon/iecode-core, sans steamcmd).",
	"type": "module",
	"main": "src/index.ts",
	"module": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": {
			"bun": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./scraper": {
			"bun": "./src/scraper.ts",
			"default": "./src/scraper.ts"
		},
		"./sync": {
			"bun": "./src/sync.ts",
			"default": "./src/sync.ts"
		}
	},
	"bin": {
		"steam-sync": "./src/cli.ts"
	},
	"scripts": {
		"lint": "oxlint src",
		"lint:fix": "oxlint src --fix",
		"type-check": "tsc --noEmit",
		"test": "bun test",
		"clean": "rm -rf *.tsbuildinfo"
	},
	"dependencies": {
		"@aphrody-code/bxc": "^0.6.0",
		"@rose-griffon/iecode-core": "workspace:*"
	},
	"devDependencies": {
		"@rose-griffon/iecode-config": "workspace:*",
		"@types/bun": "catalog:",
		"oxlint": "catalog:",
		"typescript": "catalog:"
	}
}
