[Unit]
Description=iecode CDN — streaming LIVE des assets menu depuis les CPK IEVR (g4tx->png à la volée)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/rg/iecode/packages/cdn
Environment=PATH=/home/ubuntu/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=DOTNET_ROOT=/usr/lib/dotnet
Environment=CDN_PORT=8788
Environment=IEVR_GAME_PATH=/home/ubuntu/.local/share/Steam/iecode/inazuma
ExecStart=/home/ubuntu/.bun/bin/bun src/server.ts
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
