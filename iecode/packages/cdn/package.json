{
	"name": "@rose-griffon/iecode-cdn",
	"version": "0.1.0",
	"private": true,
	"description": "Sert/exporte l'arbre d'assets menu azalee (cdn.rosegriffon.fr/dx11/menu/**.png) pixel-perfect depuis les CPK IEVR, via IECODE.Core (résolveur G4TX→PNG lossless, export batch, serve HTTP ?format=png). Aucune écriture en prod.",
	"type": "module",
	"main": "src/index.ts",
	"module": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": {
			"bun": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"bin": {
		"iecode-cdn": "./src/cli.ts"
	},
	"scripts": {
		"lint": "oxlint src",
		"lint:fix": "oxlint src --fix",
		"type-check": "tsc --noEmit",
		"test": "bun test",
		"clean": "rm -rf *.tsbuildinfo"
	},
	"dependencies": {
		"@rose-griffon/iecode-core": "workspace:*"
	},
	"devDependencies": {
		"@rose-griffon/iecode-config": "workspace:*",
		"@types/bun": "catalog:",
		"oxlint": "catalog:",
		"typescript": "catalog:"
	}
}
