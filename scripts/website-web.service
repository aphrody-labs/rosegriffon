# website-web.service — site Next.js 16 (monorepo rg) self-host VPS
# Reverse-proxy nginx rosegriffon.fr/www -> 127.0.0.1:3004.
# Prérequis : build standalone présent (~/rg/apps/website/.next/standalone) + .env (Vercel pull, VERCEL* retirés).
# Source de vérité tenue en repo (scripts/website-web.service) ; copie installée dans /etc/systemd/system/.
[Unit]
Description=Website rosegriffon.fr (Next.js 16, Bun runtime)
After=network.target network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/rg/apps/website

EnvironmentFile=-/home/ubuntu/rg/apps/website/.env
Environment=NODE_ENV=production
Environment=PORT=3004
# Bind loopback uniquement : nginx (local) est le seul à proxifier.
Environment=HOSTNAME=127.0.0.1
Environment=BUN_RUNTIME_TRANSPILER_CACHE_PATH=/home/ubuntu/rg/apps/website/.bun-cache

# Build `output: "standalone"` (!VERCEL) : serveur autonome, PAS `next start`.
# Prérequis deploy (scripts/deploy-website.sh) après `next build` :
#   cp -r .next/static .next/standalone/apps/website/.next/static
#   cp -r public        .next/standalone/apps/website/public
ExecStart=/home/ubuntu/.bun/bin/bun .next/standalone/apps/website/server.js

TimeoutStopSec=60
KillMode=mixed
KillSignal=SIGTERM
Restart=always
RestartSec=3

# Ressources (Next SSR/ISR — RSS attendu ~400-800 MiB)
MemoryHigh=2560M
MemoryMax=4G
MemorySwapMax=512M
MemoryLow=256M
TasksMax=2048
OOMScoreAdjust=-200
CPUWeight=150
IOWeight=150

# Hardening (JIT-safe — PAS de MemoryDenyWriteExecute, casse le JIT Bun/V8)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
ProtectClock=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@obsolete @privileged
# Next écrit le cache ISR/fetch dans .next/cache
ReadWritePaths=/home/ubuntu/rg/apps/website/.next /home/ubuntu/rg/apps/website/.bun-cache

LimitNOFILE=131072
StandardOutput=journal
StandardError=journal
SyslogIdentifier=website-web

[Install]
WantedBy=multi-user.target
