# azalee-watchdog.service — sonde de santé azalee-web (déclenchée par .timer).
# Root : doit pouvoir `systemctl restart azalee-web.service`. Source repo : scripts/.
[Unit]
Description=Watchdog azalee-web (santé :3003 + mémoire -> restart auto)
After=azalee-web.service
# Pas de Requires : le watchdog doit tourner même si azalee est tombé (c'est le but).

[Service]
Type=oneshot
ExecStart=/home/ubuntu/rg/scripts/azalee-watchdog.sh
# Garde-fous d'exécution du watchdog lui-même
TimeoutStartSec=90
Nice=5
