<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="IESE.App"
    xmlns:local="using:IESE"
    xmlns:styling="clr-namespace:FluentAvalonia.Styling;assembly=FluentAvalonia"
    xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    RequestedThemeVariant="Default"
>
    <!-- Default follows the OS preference; the Fluent theme supplies controls while
         the Material icon set keeps tool affordances consistent across plugins. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="IECODE.SurfaceBrush" Color="#FFF8FAFC" />
                    <SolidColorBrush x:Key="IECODE.SurfaceRaisedBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="IECODE.AccentBrush" Color="#FF2563EB" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="IECODE.SurfaceBrush" Color="#FF111827" />
                    <SolidColorBrush x:Key="IECODE.SurfaceRaisedBrush" Color="#FF1F2937" />
                    <SolidColorBrush x:Key="IECODE.AccentBrush" Color="#FF60A5FA" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <styling:FluentAvaloniaTheme />
        <material:MaterialIconStyles />
        <StyleInclude Source="avares://FluentAvalonia.ProgressRing/Styling/Controls/ProgressRing.axaml" />

        <!-- Shared shell language: Fluent density and focus behavior, with a
             restrained Material-inspired surface hierarchy. Every integrated
             plugin inherits these styles without changing its view contract. -->
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource IECODE.SurfaceBrush}" />
        </Style>
        <Style Selector="Border.iecode-surface">
            <Setter Property="Background" Value="{DynamicResource IECODE.SurfaceRaisedBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="Button.iecode-primary">
            <Setter Property="Background" Value="{DynamicResource IECODE.AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="16,8" />
        </Style>
        <Style Selector="TabItem > ContentPresenter">
            <Setter Property="Margin" Value="4,0" />
        </Style>
    </Application.Styles>
</Application>
