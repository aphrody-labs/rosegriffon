{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "$comment": "Single vcpkg manifest for every C/C++ project in this workspace.",
  "name": "iecode-workspace",
  "version-string": "2026-10-03",
  "description": "Unified native dependencies for IECODE and emulator adapters",
  "builtin-baseline": "58845ed63eb19aff55e896ea1f5d51f2a0df5b66",
  "dependencies": [],
  "features": {
    "qt6": {
      "description": "Reserved Qt 6 frontend dependencies for the optional melonDS frontend",
      "dependencies": [
        {
          "name": "qtbase",
          "default-features": false,
          "features": [
            "gui",
            "network",
            "png",
            "thread",
            "widgets",
            "opengl",
            "zstd",
            "harfbuzz"
          ]
        },
        {
          "name": "qtbase",
          "platform": "linux",
          "default-features": false,
          "features": [
            "dbus",
            "xcb",
            "xkb",
            "xcb-xlib",
            "freetype",
            "fontconfig"
          ]
        },
        {
          "name": "qtmultimedia",
          "default-features": false,
          "features": ["widgets"]
        },
        {
          "name": "qtmultimedia",
          "platform": "linux",
          "default-features": false,
          "features": ["gstreamer"]
        },
        "qtsvg",
        {
          "name": "ecm",
          "platform": "linux"
        }
      ]
    },
    "emu-host": {
      "description": "Bun OS emulator host (packages/bun-emu-host): Qt 6 Core/Gui with the offscreen platform for headless C++ emulator cores.",
      "dependencies": [
        {
          "name": "qtbase",
          "default-features": false,
          "features": ["gui", "thread", "concurrent"]
        },
        {
          "name": "dirent",
          "platform": "windows"
        }
      ]
    },
    "iecode-cpp": {
      "description": "IECODE native core, CLI and tests (engine/game disabled).",
      "dependencies": [
        "bgfx",
        "capstone",
        "cli11",
        "directxtex",
        "fmt",
        "spdlog",
        "gtest",
        "libwebp",
        "nlohmann-json",
        "tree-sitter",
        "zstd",
        "glm",
        "zlib",
        "openssl",
        {
          "name": "cpp-httplib",
          "features": ["openssl"]
        },
        {
          "name": "pkgconf",
          "host": true
        }
      ]
    },
    "engine": {
      "description": "Optional native engine/game physics and Lua adapters.",
      "dependencies": ["bullet3", "lua", "sol2"]
    },
    "melonds": {
      "description": "Reserved melonDS native adapter networking, media and SDL dependencies.",
      "dependencies": [
        "enet",
        "faad2",
        "libarchive",
        "libslirp",
        {
          "name": "sdl2",
          "platform": "linux"
        },
        {
          "name": "dirent",
          "platform": "windows"
        }
      ]
    },
    "native-display": {
      "description": "Optional display development libraries; core bgfx also requires host graphics development libraries.",
      "dependencies": ["opengl", "wayland", "egl", "libx11"]
    }
  }
}
