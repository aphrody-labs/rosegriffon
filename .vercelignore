# Ignore node_modules and builds
node_modules
.next
.turbo
.git
dist
build
.gemini
/scratch
/bin
apps/bot
# apps/azalee
apps/azalee/tests-e2e
apps/azalee/playwright-report
apps/azalee/test-results
/data
.bun-cache
.agents
/supabase
*.sqlite
data/backups
**/data/backups
# Build artefacts imbriqués (déploiement depuis la racine = upload de tout le monorepo)
**/.next
**/.turbo
**/.bun-cache
.claude
# tools/llm-agents : wrappers sous-agents grok/agy (hors build Vercel, dev/orchestration only).
# ANCRÉ à la racine (`/tools`) : un motif nu `tools` matche à toute profondeur et
# excluait par erreur `apps/website/src/components/tools/` (PfpGenerator/PfpThemeImage)
# → « Module not found » au build Vercel.
/tools
# azalee n'est PAS buildé par le déploiement website (turbo --filter=@rose-griffon/website...)
apps/azalee/.next
apps/azalee/data
apps/azalee/public

# iecode : C#/.NET + corpus RE — entièrement hors des builds Vercel (website/azalee).
# CRUCIAL : `iecode/vendor` était exclu mais `iecode/packages/*` restait uploadé en
# tant que membre du workspace ; or `iecode/packages/core` dépend de
# `file:../../vendor/node-api-dotnet/out/pkg/node-api-dotnet` (vendor exclu + `out/`
# gitignoré) → `bun install` à la racine échouait avec « failed to resolve
# node-api-dotnet » → CHAQUE déploiement website/azalee en Error. Aucun app ni
# `packages/*` ne dépend de `iecode/packages/*` (vérifié), on exclut donc tout iecode.
iecode/src
iecode/dotnet
iecode/vendor
iecode/packages
iecode/re
iecode/docs
iecode/IECODE.sln
iecode/global.json
iecode/gpu-bridge
