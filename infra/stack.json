{
  "schemaVersion": 1,
  "stackVersion": "1.0.0",
  "name": "rose-griffon-production",
  "policy": {
    "sourceOfTruth": "git",
    "secrets": "environment-files",
    "mutations": "explicit-apply-only",
    "retiredServicesAreNotStarted": true,
    "diskWarningPercent": 85,
    "diskCriticalPercent": 95
  },
  "components": [
    {
      "id": "nginx",
      "kind": "gateway",
      "owner": "rg",
      "unit": "nginx.service",
      "source": "package",
      "required": true,
      "ports": [80, 443]
    },
    {
      "id": "website",
      "kind": "next",
      "owner": "rg",
      "unit": "website-web.service",
      "source": "rg",
      "required": true,
      "ports": [3004],
      "health": "https://rosegriffon.fr/api/health"
    },
    {
      "id": "api",
      "kind": "bun-api",
      "owner": "rg",
      "unit": "rg-api.service",
      "source": "rg",
      "required": true,
      "ports": [8800],
      "health": "https://api.rosegriffon.fr/health"
    },
    {
      "id": "cdn",
      "kind": "bun-cdn",
      "owner": "rg",
      "unit": "rg-cdn.service",
      "source": "rg",
      "required": true,
      "ports": [8804],
      "health": "https://cdn.rosegriffon.fr/health"
    },
    {
      "id": "realtime",
      "kind": "bun-realtime",
      "owner": "rg",
      "unit": "rg-realtime.service",
      "source": "rg",
      "required": true,
      "ports": [8812]
    },
    {
      "id": "storage",
      "kind": "bun-storage",
      "owner": "rg",
      "unit": "rg-storage.service",
      "source": "rg",
      "required": true,
      "ports": [8810]
    },
    {
      "id": "cron",
      "kind": "scheduler",
      "owner": "rg",
      "unit": "rg-cron.service",
      "source": "rg",
      "required": true,
      "ports": [3005]
    },
    {
      "id": "infra-monitor",
      "kind": "monitor",
      "owner": "rg",
      "unit": "rg-infra-monitor.service",
      "source": "rg",
      "required": true,
      "oneshot": true,
      "timer": "rg-infra-monitor.timer"
    },
    {
      "id": "model",
      "kind": "asset-decoder",
      "owner": "niers",
      "unit": "nie-model-serve.service",
      "source": "niers",
      "required": false,
      "ports": [8790],
      "health": "http://127.0.0.1:8790/health"
    },
    {
      "id": "website-standby",
      "kind": "next-standby",
      "owner": "rg",
      "unit": "website-web-b.service",
      "source": "rg",
      "required": false,
      "standby": true,
      "ports": [3014]
    },
    {
      "id": "cdn-variants-retired",
      "kind": "retired",
      "owner": "niers",
      "unit": "cdn-variants.service",
      "source": "niers",
      "required": false,
      "retired": true,
      "ports": [8805]
    }
  ]
}
