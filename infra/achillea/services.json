{
	"schemaVersion": 1,
	"application": "achillea",
	"ownership": {
		"workspace": "/home/ubuntu/rg",
		"backend": "apps/achillea-bot",
		"frontend": "apps/website (/achillea)",
		"productionSecretsFile": "/etc/rose-griffon/achillea.env",
		"localSecretsConvention": "$HOME/.bash_secrets"
	},
	"services": [
		{
			"id": "backend",
			"kind": "supervisor",
			"workingDirectory": "apps/achillea-bot",
			"developmentCommand": ["bun", "run", "dev"],
			"productionCommand": ["bun", "build/main.js"],
			"owns": ["api", "socket-io", "ranked"],
			"health": "http://127.0.0.1:4000/health/check"
		},
		{
			"id": "api",
			"kind": "http",
			"parent": "backend",
			"bind": "127.0.0.1",
			"port": 4000,
			"health": "http://127.0.0.1:4000/health/check",
			"publicIngress": "ranked-proxy-only"
		},
		{
			"id": "ranked",
			"kind": "http-websocket",
			"parent": "backend",
			"bind": "127.0.0.1",
			"port": 4002,
			"health": "http://127.0.0.1:4002/api/health",
			"publicIngress": "https://ranked.rosegriffon.fr"
		},
		{
			"id": "socket-io",
			"kind": "websocket",
			"parent": "backend",
			"bind": "127.0.0.1",
			"port": 4005,
			"health": "tcp://127.0.0.1:4005",
			"publicIngress": "https://ranked.rosegriffon.fr/socket.io/"
		},
		{
			"id": "frontend",
			"kind": "next-route",
			"workingDirectory": "apps/website",
			"buildCommand": ["bun", "run", "build"],
			"publicIngress": "https://rosegriffon.fr/achillea"
		}
	],
	"dependencies": [
		{
			"id": "postgresql",
			"kind": "supabase-postgresql",
			"required": true,
			"environment": ["DATABASE_URL"],
			"legacyEnvironment": [
				"DATABASE_HOST",
				"DATABASE_PORT",
				"DATABASE_NAME",
				"DATABASE_USER",
				"DATABASE_PASSWORD"
			]
		},
		{
			"id": "redis",
			"kind": "redis",
			"required": true,
			"environment": ["REDIS_HOST", "REDIS_PORT"]
		},
		{
			"id": "supabase-storage",
			"kind": "supabase-storage",
			"required": true,
			"environment": [
				"SUPABASE_URL",
				"SUPABASE_SECRET_KEY",
				"SUPABASE_STORAGE_BUCKET",
				"SUPABASE_PRIVATE_STORAGE_BUCKET",
				"SUPABASE_SIGNED_URL_TTL"
			]
		}
	],
	"environment": {
		"unit": {
			"NODE_ENV": "production",
			"API_PORT": "4000",
			"API_HOST": "127.0.0.1",
			"RANKED_PORT": "4002",
			"RANKED_HOST": "127.0.0.1",
			"SOCKET_PORT": "4005",
			"SOCKET_HOST": "127.0.0.1",
			"RANKED_ENTRY": "/home/ubuntu/rg/apps/achillea-bot/build/ranked/main.js"
		},
		"requiredServerSecrets": [
			"BOT_TOKEN",
			"DEV_BOT_TOKEN",
			"DISCORD_CLIENT_SECRET",
			"DATABASE_URL",
			"API_ADMIN_TOKEN",
			"JWT_SECRET_KEY",
			"RANKED_INTERNAL_SECRET",
			"SUPABASE_SECRET_KEY"
		],
		"legacyServerSecrets": ["DATABASE_PASSWORD", "SUPABASE_SERVICE_KEY"],
		"requiredServerConfiguration": [
			"TEST_GUILD_ID",
			"BOT_OWNER_ID",
			"DISCORD_CLIENT_ID",
			"REDIS_HOST",
			"REDIS_PORT",
			"WEBSITE_URL",
			"PUBLIC_API_URL",
			"OAUTH_CALLBACK_BASE_URL",
			"WEB_ALLOWED_ORIGINS",
			"RANKED_ALLOWED_ORIGINS",
			"RANKED_PUBLIC_URL",
			"SUPABASE_URL",
			"SUPABASE_STORAGE_BUCKET",
			"SUPABASE_PRIVATE_STORAGE_BUCKET",
			"SUPABASE_SIGNED_URL_TTL"
		],
		"optionalServerConfiguration": [
			"ACHILLEA_CROSS_SYNC_TARGETS",
			"ACHILLEA_CROSS_SYNC_RECEIVE_SECRET",
			"ACHILLEA_STAFF_CHANNEL_ID",
			"CHALLONGE_API_KEY",
			"CHALLONGE_BASE_URL",
			"CHALLONGE_CLIENT_ID",
			"GOOGLE_DRIVE_FOLDER_ID",
			"GOOGLE_PLAYER_NOTES_DOC_ID",
			"GOOGLE_SERVICE_ACCOUNT_KEY_FILE",
			"RANKED_STORAGE_DIR",
			"TWITCH_CLIENT_ID",
			"TWITCH_SECRET"
		],
		"publicBrowserConfiguration": [
			"NEXT_PUBLIC_ACHILLEA_API_URL",
			"NEXT_PUBLIC_ACHILLEA_COLYSEUS_URL"
		]
	},
	"uploads": {
		"owner": "backend-only",
		"provider": "supabase-storage",
		"buckets": {
			"publicImages": {
				"variable": "SUPABASE_STORAGE_BUCKET",
				"default": "images",
				"public": true
			},
			"privateRankedProofs": {
				"variable": "SUPABASE_PRIVATE_STORAGE_BUCKET",
				"default": "ranked-proofs",
				"public": false,
				"signedUrlTtlVariable": "SUPABASE_SIGNED_URL_TTL",
				"signedUrlTtlDefaultSeconds": 3600
			}
		},
		"serverCredential": "SUPABASE_SECRET_KEY",
		"legacyServerCredential": "SUPABASE_SERVICE_KEY",
		"browserCredential": "SUPABASE_PUBLISHABLE_KEY",
		"publicPaths": ["proxy/", "discord/"],
		"privatePaths": ["proof/"],
		"proxy": {
			"maximumBytes": 6291456,
			"mimeTypes": ["image/png", "image/jpeg", "image/webp", "image/gif"],
			"authentication": "cookie-jwt"
		},
		"rankedProof": {
			"maximumDecodedBytes": 5242880,
			"transportMaximum": "8mb-base64-text",
			"mimeTypes": ["image/png", "image/jpeg", "image/webp"],
			"authentication": "cookie-or-bearer-jwt",
			"fallback": "apps/achillea-bot/storage/disputes"
		}
	},
	"localSupabaseTarget": {
		"status": "active",
		"database": "rg",
		"schema": "achillea",
		"forbiddenSchemas": ["public", "auth", "storage", "graphql", "extensions"],
		"databaseHost": "/var/run/postgresql",
		"databasePort": 5432,
		"storageRoot": "/var/www/achillea-storage",
		"secretsFiles": [
			"/etc/rose-griffon/achillea-postgrest.env",
			"/etc/rose-griffon/achillea-storage.env",
			"/etc/rose-griffon/achillea-realtime.env",
			"/etc/rose-griffon/achillea-auth.env"
		],
		"services": [
			{
				"id": "achillea-postgrest",
				"port": 8820,
				"unit": "infra/systemd/achillea-postgrest.service"
			},
			{
				"id": "achillea-storage",
				"port": 8821,
				"unit": "infra/systemd/achillea-storage.service"
			},
			{
				"id": "achillea-realtime",
				"port": 8822,
				"unit": "infra/systemd/achillea-realtime.service"
			},
			{
				"id": "achillea-supabase-internal",
				"port": 8823,
				"config": "infra/nginx/achillea-supabase-internal.conf"
			},
			{
				"id": "achillea-auth",
				"port": 8824,
				"unit": "infra/systemd/achillea-auth.service"
			}
		],
		"authApi": {
			"status": "retired",
			"reason": "Achillea has no session of its own: it derives from the Rose Griffon account. GoTrue (achillea-auth.service, :8824) was stopped and disabled on 2026-09-20, along with its watchdog timer, and both gateways return 410 on /auth/v1/. The auth schema is kept in the database until its historical accounts are migrated."
		}
	},
	"productionChecks": [
		"http://127.0.0.1:4000/health/check",
		"http://127.0.0.1:4002/api/health",
		"tcp://127.0.0.1:4005",
		"https://achillea.rosegriffon.fr/",
		"https://ranked.rosegriffon.fr/api/health"
	]
}
