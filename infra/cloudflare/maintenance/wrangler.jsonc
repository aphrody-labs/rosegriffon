// rosegriffon.fr: no application; every Rose Griffon web host answers the maintenance page (503) from the edge.
// Moved from aphrody-labs/bun-ui packages/web/cloudflare/maintenance. Deploy once the rosegriffon.fr zone is active
// (routes need an active zone): wrangler deploy --config infra/cloudflare/maintenance/wrangler.jsonc, or let
// bun-ui packages/web/cloudflare/scripts/ovh.ts deploy it with RG_MAINTENANCE_WRANGLER_CONFIG set to this file.
{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "rosegriffon-maintenance",
  "main": "worker.ts",
  "compatibility_date": "2026-10-12",
  "workers_dev": false,
  "routes": [
    { "pattern": "rosegriffon.fr/*", "zone_name": "rosegriffon.fr" },
    { "pattern": "*.rosegriffon.fr/*", "zone_name": "rosegriffon.fr" },
  ],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": true, "traces": { "enabled": true, "head_sampling_rate": 0.1 } },
}
