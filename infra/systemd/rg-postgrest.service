[Unit]
Description=PostgREST — API REST compatible Supabase sur la base rg locale
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
ExecStart=/usr/local/bin/postgrest /etc/postgrest.conf
Restart=always
RestartSec=2

# Plafond mémoire (raisonnement complet dans azalee-api.service). Mesuré : 92 Mio ;
# PostgREST garde un pool de connexions, pas les résultats.
MemoryHigh=1G
MemoryMax=2G
MemorySwapMax=256M
User=postgrest
Group=postgrest
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
