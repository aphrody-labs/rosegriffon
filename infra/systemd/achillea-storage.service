[Unit]
Description=Achillea Supabase-compatible Storage (isolated)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/rg
EnvironmentFile=/etc/rose-griffon/achillea-storage.env
Environment=PATH=/home/ubuntu/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=RG_STORAGE_HOST=127.0.0.1
Environment=RG_STORAGE_PORT=8821
Environment=RG_STORAGE_ROOT=/var/www/achillea-storage
ExecStart=/home/ubuntu/.bun/bin/bun apps/storage/server.ts
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/www/achillea-storage
LockPersonality=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryHigh=1G
MemoryMax=2G
StandardOutput=journal
StandardError=journal
SyslogIdentifier=achillea-storage

[Install]
WantedBy=multi-user.target
