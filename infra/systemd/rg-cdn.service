[Unit]
Description=rg CDN — serveur d'images (upload/images/health) pour cdn.rosegriffon.fr
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/rg/apps/cdn
EnvironmentFile=/home/ubuntu/rg/apps/cdn/.env
ExecStart=/home/ubuntu/.bun/bin/bun server.ts
# `always` : une sortie en code 0 laissait le service mort sans alerte (cf. cdn-variants).
Restart=always
RestartSec=3

# Plafond mémoire (raisonnement complet dans les unités de production). Mesuré : 8 Mio ; le
# service diffuse des fichiers, il ne les charge pas.
MemoryHigh=512M
MemoryMax=1G
MemorySwapMax=256M

[Install]
WantedBy=multi-user.target
