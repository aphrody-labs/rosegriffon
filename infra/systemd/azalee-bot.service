[Unit]
# azalee-bot — bot Discord du serveur Azalée (« 𝓐𝔃𝓪𝓵𝓮́𝓮 🌸 », guilde
# 1349526851672080414).
#
# ⚠ CE N'EST PAS UN SECOND PROGRAMME. C'est le MÊME code que `rg-bot.service`
# (`/home/ubuntu/rg/apps/bot`), lancé une seconde fois avec un autre PROFIL et
# un autre jeton. Rien n'est dupliqué : un correctif appliqué au bot Rose
# Griffon vaut immédiatement pour celui-ci, et réciproquement. Toute
# divergence de comportement entre les deux bots doit passer par le registre de
# profils (`apps/bot/src/lib/profil.ts`) — jamais par une copie de fichier.
#
# Le profil `azalee` décide : le jeton lu (`AZALEE_DISCORD_BOT_TOKEN`), la
# guilde où les commandes sont enregistrées (Azalée seule), QUELLES commandes
# sont chargées (données de jeu IEVR, archives CPK, CDN, RAG, archive des posts
# X, et la racine `/staff` de consultation), la marque des embeds, le salon
# d'annonce des nouveaux posts X (1349528692086276148) et le nom du curseur de
# ce flux (`azalee`).
#
# ── À FAIRE AVANT LA PREMIÈRE INSTALLATION ─────────────────────────────────
#   1. créer l'application et son bot dans le portail développeur Discord, et
#      y activer l'intent privilégié « Server Members Intent » (le code
#      demande `Guilds` + `GuildMembers` ; sans l'intent activé, Discord ferme
#      la passerelle en 4014 « Disallowed intent(s) » et le service boucle) ;
#   2. poser le jeton dans `AZALEE_DISCORD_BOT_TOKEN` — voir la section
#      EnvironmentFile plus bas. Le jeton ne va JAMAIS dans ce fichier, qui est
#      suivi par git ;
#   3. inviter le bot sur la guilde Azalée avec les scopes `bot` +
#      `applications.commands` et les permissions 52224.
# La marche à suivre complète, URL d'invitation comprise : `docs/bot-azalee.md`.
#
# Installation :
#   sudo cp infra/systemd/azalee-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now azalee-bot.service
Description=Azalée Discord Bot (Bun + discordx — profil azalee du bot rg)
# Ordonnancement seulement (pas de `Wants=` : aucun de ces services n'est tiré
# au démarrage par celui-ci). Le bot lit Postgres directement (Bun.SQL),
# interroge l'API Azalée en boucle locale (:8807) pour ses fiches de jeu et ses
# fichiers CPK, et rag-api (:8806) pour `/rag`. Aucun n'est requis pour
# démarrer : une commande dont le service est éteint échoue seule, avec son
# message.
After=network-online.target rg-postgrest.service azalee-api.service rag-api.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu

# ⚠ OBLIGATOIRE, et c'est le MÊME répertoire que rg-bot : Bun lit le
# `tsconfig.json` du répertoire courant, et c'est `apps/bot/tsconfig.json` qui
# porte `experimentalDecorators` + `emitDecoratorMetadata`. Lancé depuis la
# racine du dépôt, le bot part sur le tsconfig racine (décorateurs TC39) et
# discordx meurt aussitôt sur « TypeError: undefined is not an object
# (evaluating 'descriptor.value') ». Deux services, un seul répertoire de
# travail : c'est exactement le point du chantier.
WorkingDirectory=/home/ubuntu/rg/apps/bot

# Ordre volontaire, du plus commun au plus spécifique — le dernier lu gagne :
#   1. `apps/bot/.env`   : extras du bot (REDIS_URL, SYNC_INTERVAL_MS…) ;
#   2. `.env.local`      : racine partagée avec rg-bot et rg-cron (Postgres,
#      Supabase self-host, jeton du bot Rose Griffon). Une rotation de secret
#      faite là se propage ici sans rien recopier ;
#   3. `/etc/azalee-bot.env` (facultatif, root:root 0600) : le jeton propre à
#      ce bot, hors du dépôt. C'est l'emplacement recommandé pour
#      `AZALEE_DISCORD_BOT_TOKEN`. À défaut, la même variable posée dans
#      `.env.local` fait l'affaire (ce fichier est gitignoré).
# Les deux bots partagent donc la base, le cache et les services internes, mais
# JAMAIS leur jeton : `DISCORD_BOT_TOKEN` reste celui de Rose Griffon et le
# profil `azalee` ne le lit pas.
EnvironmentFile=-/home/ubuntu/rg/apps/bot/.env
EnvironmentFile=/home/ubuntu/rg/.env.local
EnvironmentFile=-/etc/azalee-bot.env
Environment=NODE_ENV=production

# LE drapeau qui distingue ce service de rg-bot. Tout le reste en découle.
Environment=RG_PROFIL_BOT=azalee

# `PATH` est OBLIGATOIRE : systemd n'en fournit pas qui contienne
# `/home/ubuntu/.bun/bin`.
Environment=PATH=/home/ubuntu/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Ce bot ne synchronise RIEN. Les membres du serveur Azalée n'ont pas à entrer
# dans `discord_members`, qui ne décrit que la communauté Rose Griffon, et la
# synchronisation de celle-ci appartient à rg-cron. Ne jamais passer à 1 ici :
# ce serait une troisième source d'écriture sur les mêmes tables.
Environment=BOT_SYNC_MEMBRES=0

# AUCUNE cible publique n'est posée ici, et c'est volontaire — trois pièges
# évités d'un coup :
#
#  1. `WEBSITE_URL` appartient au profil `rg` (`marque.variableUrlBase`). Le
#     profil `azalee` lit `AZALEE_WEBSITE_URL` et vaut déjà
#     `https://azalee.rosegriffon.fr` par défaut : poser `WEBSITE_URL` ici ne
#     changerait rien aux liens de ce bot, et laisserait croire le contraire.
#     Ne poser `AZALEE_WEBSITE_URL` que pour viser une préversion.
#  2. `WEBSITE_API_URL` garderait de toute façon son défaut
#     (`https://rosegriffon.fr`, cf. `src/lib/api.ts`) : les routes
#     `/api/bot/v1/*` n'existent QUE sur le site principal — `apps/azalee/app/api`
#     n'en a aucune. Le pointer sur azalee.rosegriffon.fr donnerait des 404.
#  3. `AZALEE_API_URL` a déjà le bon défaut dans `src/lib/azalee.ts` :
#     `http://127.0.0.1:8807`, l'API headless en boucle locale.
#
# `DISCORD_GUILD_ID`, `DISCORD_EXTRA_GUILD_IDS` et `DISCORD_NEWS_CHANNEL_ID`
# viennent du fichier racine partagé et décrivent le serveur Rose Griffon : le
# profil `azalee` les ignore par construction (`guildesDuProfil`,
# `salonAnnonceDuProfil`). Ne pas les redéfinir ici. Pour déplacer l'annonce
# d'Azalée dans un autre salon sans toucher au code, la variable est
# `AZALEE_DISCORD_NEWS_CHANNEL_ID`.

ExecStart=/home/ubuntu/.bun/bin/bun run src/index.ts
# `always` : une déconnexion Discord qui se solde par une sortie en code 0 n'était
# jamais relancée — le bot restait silencieux sans qu'aucune unité ne soit en échec.
Restart=always
RestartSec=5s
TimeoutStopSec=15s
KillMode=mixed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=azalee-bot

# ── Limites de ressources ──
# Calquées sur rg-bot : même programme, même empreinte. Ce profil sert moins de
# commandes mais lit les mêmes tables et le même cache.
LimitNOFILE=131072
TasksMax=512
MemoryMax=1G
MemoryHigh=768M
MemoryLow=256M
CPUWeight=200
IOWeight=200
OOMScoreAdjust=-300

# ── Durcissement (MemoryDenyWriteExecute INTERDIT — casse le JIT de Bun) ──
ProtectSystem=strict
ProtectHome=read-only
# Le bot ne persiste rien : il lit ses sources et écrit uniquement des fichiers
# temporaires. Sans cette ligne, ProtectSystem=strict rendrait la moindre
# écriture EROFS. Conséquence assumée et documentée dans `src/lib/azalee.ts` :
# le miroir SQLite du wiki est en lecture seule pour ce service, donc les
# données de jeu passent par l'API HTTP locale, jamais par `bun:sqlite`.
ReadWritePaths=/home/ubuntu/rg/apps/bot /tmp
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
NoNewPrivileges=true
ProcSubset=pid
ProtectProc=invisible
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
# Deux directives, pas une : systemd n'accepte pas de mélanger liste blanche et
# liste noire sur la même ligne — il lirait « ~@obsolete » comme un nom d'appel
# système inconnu (« System call ~@obsolete is not known, ignoring »), ignorerait
# le retrait, et laisserait donc @privileged AUTORISÉ. La seconde ligne soustrait
# bien les deux groupes de l'ensemble accordé par la première.
SystemCallFilter=@system-service
SystemCallFilter=~@obsolete @privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
