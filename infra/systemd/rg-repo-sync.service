[Unit]
Description=checkpoint Git RG/Niers — sans déploiement
Documentation=file:///home/ubuntu/rg/docs/REPO-SYNC.md
After=network-online.target
Wants=network-online.target
ConditionPathExists=/home/ubuntu/rg/scripts/ops/repo-sync.ts

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/rg
Environment=PATH=/home/ubuntu/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=RG_ROOT=/home/ubuntu/rg
Environment=NIERS_ROOT=/home/ubuntu/niers
# Le timer checkpoint les changements sûrs, mais ne pousse ni ne publie rien.
Environment=REPO_SYNC_AUTOCOMMIT=1
Environment=REPO_SYNC_PUSH=0
ExecStart=/home/ubuntu/.bun/bin/bun /home/ubuntu/rg/scripts/ops/repo-sync.ts --repo all --commit --json
Nice=15
IOSchedulingClass=idle
CPUQuota=20%
MemoryMax=256M
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/rg /home/ubuntu/niers
