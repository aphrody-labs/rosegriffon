[Unit]
# rg-mcp — serveur MCP du monorepo Rose Griffon (@rose-griffon/mcp),
# exposé derrière nginx sur https://mcp.rosegriffon.fr/ (et
# https://api.rosegriffon.fr/mcp).
#
# C'est ce que contacte un Claude Code exécuté sur une autre machine : il y
# trouve les données du jeu (wiki Azalée, miroir SQLite, index CPK, texte du
# jeu), le contenu du dépôt et l'état de la production.
#
# DEUX PORTÉES, décidées par le jeton présenté :
#   - `RG_MCP_TOKEN`       (/etc/rg-mcp.env) → lecture seule ;
#   - `RG_MCP_ADMIN_TOKEN` (/home/ubuntu/rg/.env, chargé nativement par Bun)
#     → écriture, suppression, exécution de commandes, actions systemd.
# Le second est un accès équivalent à un accès SSH : le traiter comme tel.
#
# Installation :
#   sudo cp infra/systemd/rg-mcp.service /etc/systemd/system/
#   sudo install -m 600 /dev/null /etc/rg-mcp.env
#   printf 'RG_MCP_TOKEN=%s\n' "$(openssl rand -hex 32)" | sudo tee /etc/rg-mcp.env
#   sudo systemctl daemon-reload && sudo systemctl enable --now rg-mcp.service
Description=rg-mcp — serveur MCP Rose Griffon (Bun, lecture + administration sur jeton)
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/rg
Environment=PATH=/home/ubuntu/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=RG_MCP_PORT=8808
Environment=RG_MCP_HOST=127.0.0.1
Environment=RG_MCP_ENDPOINT=/mcp
# Même miroir que le wiki et l'API headless.
Environment=SQLITE_DB_PATH=/home/ubuntu/rg/apps/azalee/data/backups/mirror.sqlite
Environment=AZALEE_DATA_DIR=/home/ubuntu/rg/apps/azalee/data
# Jeton porteur exigé sur chaque requête. Le fichier n'est PAS optionnel :
# sans lui, l'endpoint distant serait ouvert à tous.
EnvironmentFile=/etc/rg-mcp.env
ExecStart=/home/ubuntu/.bun/bin/bun packages/mcp/src/cli.ts serve --http
Restart=always
RestartSec=5

# Durcissement. Le système reste en lecture seule : même la portée `admin`
# ne peut écrire que dans le dépôt et /tmp (matérialisation de l'index CPK).
# C'est une seconde barrière — la première reste le jeton.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=false
ReadWritePaths=/home/ubuntu/rg /tmp
LockPersonality=true
# `NoNewPrivileges` est volontairement ABSENT : il interdirait `sudo`, dont
# l'outil `ops_service` a besoin pour agir sur les unités systemd.

[Install]
WantedBy=multi-user.target
