[Unit]
# azalee-api — API HTTP headless de la bibliothèque @rose-griffon/azalee,
# exposée derrière nginx sur https://api.rosegriffon.fr/azalee/.
#
# Sert les MÊMES données que le wiki web (miroir SQLite inagle_*, index CPK,
# index de texte de jeu) en JSON pur, sans Next. C'est la source de repli du
# CLI `azalee` et d'un GUI Tauri quand la machine cliente n'a ni base locale
# ni dump du jeu.
#
# NE PAS LIRE CETTE UNITÉ SEULE : elle est corrigée par
# `azalee-api.service.d/chemin.conf`, qui remplace `WorkingDirectory=` et
# `ExecStart=`. La commande réellement lancée est celle du drop-in, pas celle
# écrite plus bas. Les deux fichiers se déploient et se relisent ensemble.
#
# Installation :
#   sudo cp infra/systemd/azalee-api.service /etc/systemd/system/
#   sudo mkdir -p /etc/systemd/system/azalee-api.service.d
#   sudo cp infra/systemd/azalee-api.service.d/chemin.conf \
#           /etc/systemd/system/azalee-api.service.d/
#   sudo systemctl daemon-reload && sudo systemctl enable --now azalee-api.service
Description=azalee-api — API headless du wiki Azalée (Bun, lecture seule)
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/niers
Environment=PATH=/home/ubuntu/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=AZALEE_PORT=8807
Environment=AZALEE_HOST=127.0.0.1
# Miroir épinglé, republié chaque nuit par `nie-miroir.timer` (lien symbolique vers
# le dump du jour). `azalee-web` n'existe plus — l'app autonome a été fusionnée dans
# `apps/website` — mais le miroir reste la source commune du wiki et de cette API.
Environment=SQLITE_DB_PATH=/home/ubuntu/niers/var/mirror.sqlite
# CE CHEMIN N'EXISTE PLUS (`apps/azalee` a été supprimée avec l'app autonome). Le
# service n'en souffre pas : `packages/azalee/src/config.ts` traite `AZALEE_DATA_DIR`
# comme un simple candidat et retombe sur les chemins usuels. La ligne est conservée
# telle quelle parce qu'elle est en production ; la retirer demande un redémarrage
# d'`azalee-api` et doit être vérifiée contre `config.ts`, pas faite en passant.
Environment=AZALEE_DATA_DIR=/home/ubuntu/niers/apps/azalee/data
# Remplacé par le drop-in `chemin.conf` : ce module n'existe plus (`azalee-tools` a
# été absorbé par `packages/azalee`). Laissé pour que le diff avec la machine reste nul.
ExecStart=/home/ubuntu/.bun/bin/bun packages/azalee-tools/src/server/main.ts
Restart=always
RestartSec=5

# Plafond mémoire. Le 14/8/2026, huit unités de production tournaient en
# MemoryMax=infinity : une fuite dans n'importe laquelle d'entre elles pouvait épuiser
# les 45 Gio de l'hôte, et c'est l'OOM killer GLOBAL qui tranchait — il a tué
# nie-model-serve à 02h16 ce jour-là, mais le prochain choisi aurait pu être le wiki.
# Un plafond par service transforme une panne d'hôte en panne d'un seul service, que
# Restart= répare seul. Mesuré ici : 38 Mio de working set.
MemoryHigh=1G
MemoryMax=2G
MemorySwapMax=256M

# Lecture seule : le service n'écrit que ses SQLite matérialisés en tmpfs.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=false
ReadWritePaths=/tmp
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
