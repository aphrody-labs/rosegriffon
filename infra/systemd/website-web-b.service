# website-web-b.service — site rosegriffon.fr — SLOT B, doublure de bascule.
#
# Copie conforme du slot A sur le port 3014 et le lien `slot-b`. Elle ne tourne que
# pendant un déploiement, le temps que nginx bascule sur la nouvelle version, que le
# slot A soit remis à niveau, puis re-bascule. Non activée au démarrage : en régime
# stable, seul le slot A tourne.
[Unit]
Description=Website rosegriffon.fr (Next.js 16, Bun runtime) — slot B (doublure de déploiement)
After=network.target network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/rg-releases/website/slot-b/apps/website

EnvironmentFile=-/home/ubuntu/rg/apps/website/.env
Environment=NODE_ENV=production
Environment=PORT=3014
Environment=HOSTNAME=127.0.0.1
Environment=BUN_RUNTIME_TRANSPILER_CACHE_PATH=/home/ubuntu/rg-releases/website/bun-cache-b

ExecStart=/home/ubuntu/.bun/bin/bun /home/ubuntu/rg-releases/website/slot-b/apps/website/server.js

TimeoutStopSec=60
KillMode=mixed
KillSignal=SIGTERM
# Bun quitte en 143 (128+SIGTERM) au lieu de mourir du signal : sans cette ligne,
# systemd marque l'unité `failed` à chaque arrêt propre, ce qui pollue le diagnostic.
SuccessExitStatus=143
Restart=always
RestartSec=3

MemoryHigh=2G
MemoryMax=3G
MemorySwapMax=512M
MemoryLow=256M
TasksMax=2048
OOMScoreAdjust=-100
CPUWeight=150
IOWeight=150

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
ProtectClock=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@obsolete @privileged
ReadWritePaths=/home/ubuntu/rg-releases/website

LimitNOFILE=131072
StandardOutput=journal
StandardError=journal
SyslogIdentifier=website-web-b

[Install]
WantedBy=multi-user.target
