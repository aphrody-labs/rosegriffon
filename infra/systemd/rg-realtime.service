[Unit]
Description=rg-realtime — diffusion SSE des changements Postgres (remplace Supabase Realtime)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/rg
EnvironmentFile=/etc/rg-realtime.env
ExecStart=/home/ubuntu/.bun/bin/bun /home/ubuntu/rg/apps/realtime/server.ts
Restart=always
RestartSec=2
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
