[Unit]
Description=Rose Griffon Discord bot (Bun + discordx + Supabase)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
# Run from isolated production directory
WorkingDirectory=/home/ubuntu/rg/apps/bot
EnvironmentFile=/home/ubuntu/rg/apps/bot/.env
Environment=NODE_ENV=production
ExecStart=/home/ubuntu/.bun/bin/bun run src/index.ts
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
KillMode=mixed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rg-bot

# ── Resource limits (cohérent avec rpb-bot / shenron, cf. ~/vps/CLAUDE.md) ──
LimitNOFILE=131072
TasksMax=512
MemoryMax=1G
MemoryHigh=768M
MemoryLow=256M
CPUWeight=200
IOWeight=200
OOMScoreAdjust=-300

# ── Hardening systemd (MemoryDenyWriteExecute INTERDIT — casse Bun/V8 JIT) ──
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/rg/apps/bot /tmp
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
NoNewPrivileges=true
ProcSubset=pid
ProtectProc=invisible
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service ~@obsolete @privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
