[Unit]
Description=Achillea Supabase-compatible Realtime (isolated)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/rg
EnvironmentFile=/etc/rose-griffon/achillea-realtime.env
Environment=PATH=/home/ubuntu/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=RG_REALTIME_HOST=127.0.0.1
Environment=RG_REALTIME_PORT=8822
ExecStart=/home/ubuntu/.bun/bin/bun apps/realtime/server.ts
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
LockPersonality=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryHigh=512M
MemoryMax=1G
StandardOutput=journal
StandardError=journal
SyslogIdentifier=achillea-realtime

[Install]
WantedBy=multi-user.target
