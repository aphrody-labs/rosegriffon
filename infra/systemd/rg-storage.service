[Unit]
Description=Rose Griffon unified Storage API (Bun)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/rg
EnvironmentFile=-/etc/rg-storage.env
Environment=PATH=/home/ubuntu/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=RG_STORAGE_HOST=127.0.0.1
Environment=RG_STORAGE_PORT=8810
Environment=RG_STORAGE_ROOT=/var/www/rg-storage
ExecStart=/home/ubuntu/.bun/bin/bun apps/storage/server.ts
Restart=always
RestartSec=3s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/www/rg-storage /tmp
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryHigh=512M
MemoryMax=1G
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rg-storage

[Install]
WantedBy=multi-user.target
