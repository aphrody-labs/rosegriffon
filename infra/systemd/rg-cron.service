[Unit]
# rg-cron — démon de tâches planifiées du monorepo (Bun.cron).
#
# Publication programmée, préchauffage des pages, synchronisation Discord,
# sauvegardes, crawl, SEO. Le démon tourne en continu et déclenche ses tâches
# lui-même : il n'y a pas de timer systemd par tâche.
#
# Installation :
#   sudo cp infra/systemd/rg-cron.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl restart rg-cron.service
Description=Rose Griffon Cron Daemon (Bun + Bun.cron)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/rg/packages/cron
EnvironmentFile=/home/ubuntu/rg/.env.local
Environment=NODE_ENV=production

# `PATH` est OBLIGATOIRE : systemd n'en fournit pas qui contienne
# `/home/ubuntu/.bun/bin`. Sans lui, toute commande `bun …` lancée par une
# tâche échoue avec le code 127 (« command not found ») — c'est ce qui a
# silencieusement cassé les sauvegardes nocturnes. Le code utilise en plus
# `process.execPath`, mais un PATH correct reste nécessaire aux scripts
# appelés en cascade.
Environment=PATH=/home/ubuntu/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Cibles publiques. Le code a les mêmes valeurs en repli, mais les rendre
# explicites permet de basculer un environnement sans recompiler.
Environment=AZALEE_URL=https://azalee.rosegriffon.fr
Environment=WEBSITE_URL=https://rosegriffon.fr
Environment=API_URL=https://api.rosegriffon.fr
Environment=CDN_URL=https://cdn.rosegriffon.fr

# `@aphrody-code/bxc` (npm:@aphrody/bxc, tâche `crawl`/zukan) tente en dernier
# recours `cargo run --manifest-path rust-bridge/Cargo.toml` pour localiser
# Chrome — ce dossier n'est jamais publié dans le tarball npm, donc l'appel
# échoue toujours en prod (« rust-bridge/Cargo.toml does not exist »).
# CHROME_PATH court-circuite entièrement cette résolution. Repéré le 1/9/2026 :
# 3 échecs consécutifs de la tâche `crawl` (alerte cron), aucun cargo installé
# côté rg de toute façon.
Environment=CHROME_PATH=/usr/local/bin/google-chrome

ExecStart=/home/ubuntu/.bun/bin/bun run src/index.ts
# `always` : le démon planifie en continu, il n'a aucune raison de sortir. Une sortie
# en code 0 — fin de boucle inattendue, exception avalée — n'était pas relancée, et
# TOUTES les tâches planifiées s'arrêtaient sans qu'aucune unité soit en échec.
Restart=always
RestartSec=5s
TimeoutStopSec=15s
KillMode=mixed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rg-cron

# ── Limites de ressources ──
LimitNOFILE=131072
TasksMax=512
MemoryMax=1G
MemoryHigh=768M
MemoryLow=256M
CPUWeight=200
IOWeight=200
OOMScoreAdjust=-300

# ── Durcissement (MemoryDenyWriteExecute INTERDIT — casse le JIT de Bun) ──
ProtectSystem=strict
ProtectHome=read-only
# Les deux répertoires du CDN sont la cible de la tâche `cdn` : sans eux,
# `ProtectSystem=strict` rend la copie impossible et un nouvel asset partagé
# n'atteint jamais le CDN.
# `/var/lib/rg` : cache de la collecte d'audience du second serveur, lu par la
# page /admin/stats. Sans cette entrée, `ProtectSystem=strict` le rend en
# lecture seule et la tâche `stats:achillea` échoue en EROFS.
# `/home/ubuntu/niers/var` : le pipeline de données du jeu a suivi la fusion. La tâche `db`
#   y lance le push d'inagle et la republication du miroir SQLite (`scripts/donnees/
#   miroir-inagle.sh`), qui écrit dans `var/miroir/`. Sans cette entrée, `ProtectSystem=strict`
#   la fait échouer en EROFS.
ReadWritePaths=/home/ubuntu/rg /home/ubuntu/niers/var /tmp /home/ubuntu/.bxc /var/www/cdn/static/azalee/public /var/www/cdn/static/website/public /var/lib/rg
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
NoNewPrivileges=true
ProcSubset=pid
ProtectProc=invisible
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service ~@obsolete @privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
