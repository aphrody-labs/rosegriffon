{
	"$schema": "https://turborepo.dev/schema.json",
	"globalDependencies": ["tsconfig.base.json", "bunfig.toml", ".oxlintrc.json"],
	"globalEnv": ["NODE_ENV"],
	"globalPassThroughEnv": [
		"PATH",
		"HOME",
		"TERM",
		"CI",
		"GITHUB_ACTIONS",
		"VERCEL",
		"VERCEL_URL",
		"VERCEL_ENV"
	],
	"ui": "tui",
	"daemon": true,
	"cacheDir": ".turbo/cache",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!**/*.test.{ts,tsx,js,jsx}",
				"!**/*.spec.{ts,tsx,js,jsx}",
				"!**/__tests__/**",
				"!**/*.md",
				"!.next/cache/**",
				"!coverage/**"
			],
			"outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"],
			"env": [
				"DATABASE_URL",
				"DISCORD_CLIENT_ID",
				"DISCORD_CLIENT_SECRET",
				"DISCORD_BOT_TOKEN",
				"DISCORD_PUBLIC_KEY",
				"NEXT_PUBLIC_SUPABASE_URL",
				"NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
				"SUPABASE_SERVICE_ROLE_KEY",
				"SUPABASE_INTERNAL_URL",
				"SUPABASE_ACCESS_TOKEN",
				"BETTER_AUTH_URL",
				"BETTER_AUTH_SECRET",
				"NEXT_PUBLIC_SITE_URL",
				"NEXT_PUBLIC_AZALEE_URL",
				"NEXT_PUBLIC_DISCORD_INVITE_URL",
				"WEBSITE_API_URL",
				"WEBSITE_API_TOKEN"
			]
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["^build"]
		},
		"start": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["build"]
		},
		"lint": {
			"inputs": [
				"$TURBO_DEFAULT$",
				".oxlintrc.json",
				"eslint.config.*",
				"!**/*.md",
				"!.next/**",
				"!dist/**",
				"!build/**"
			],
			"outputLogs": "hash-only",
			"outputs": []
		},
		"lint:fix": {
			"cache": false,
			"outputs": []
		},
		"type-check": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"tsconfig.json",
				"tsconfig.base.json",
				"!**/*.md",
				"!.next/**",
				"!dist/**"
			],
			"outputLogs": "errors-only",
			"outputs": []
		},
		"test": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "vitest.config.*", "bun.test.ts"],
			"outputLogs": "new-only",
			"outputs": ["coverage/**"]
		},
		"clean": {
			"cache": false,
			"outputs": []
		},
		"deploy": {
			"cache": false,
			"dependsOn": ["build"]
		}
	}
}
