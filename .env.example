# rosegriffon — environment of the self-hosted executable (names only, no values).
# Copy to `.env` next to the executable or pass `--env-file <path>`.
# Per-app references: apps/rg-website/.env.example, apps/rg-bot/.env.example,
# packages/rg-cron/.env.example.

# ─── Databases ────────────────────────────────────────────────────────────────
# Supabase project `rg` (Postgres, Auth, Storage, Realtime)
RG_DATABASE_URL=
DATABASE_URL=
DATABASE_POOL_MAX=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Neon project `inagle` (game data mirror, pooled endpoint)
INAGLE_DATABASE_URL=
REDIS_URL=

# ─── Site (`rosegriffon site`) ────────────────────────────────────────────────
RG_SITE=
RG_SITE_PORT=
RG_SITE_HOST=
RG_SITE_DIR=
RG_CACHE_DIR=
NEXT_PUBLIC_BASE_URL=
WEBSITE_URL=

# ─── rg-core (`rosegriffon serve`) ────────────────────────────────────────────
RG_CORE_PORT=
RG_CORE_HOST=
RG_CORE_CRON=
RG_CORE_CRON_EXCLURE=
RG_CORE_AZALEE=
RG_CORE_MODELES=
RG_CORE_MODEL_HOSTS=
RG_CORE_BOT_HOSTS=
RG_CORE_VEILLE_MESSAGES=
RG_PROFIL_BOT=

# ─── Unified API (`rosegriffon api`) ──────────────────────────────────────────
API_PORT=
API_HOST=
API_ADMIN_TOKEN=
BOT_API_TOKEN=
UNIFIED_API_URL=
WEB_ALLOWED_ORIGINS=
CRON_SECRET=

# ─── Discord (`rosegriffon bot`) ──────────────────────────────────────────────
DISCORD_BOT_TOKEN=
AZALEE_DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
BOT_SYNC_MEMBRES=
SYNC_INTERVAL_MS=

# ─── Google / gcloud (Calendar, Drive, Docs, Sheets ; site, api, cli) ─────────
# Compte de service service-to-service. Une seule source suffit, resolue par
# apps/rg-website/src/lib/google/auth.ts dans cet ordre :
#   GOOGLE_APPLICATION_CREDENTIALS > GOOGLE_SERVICE_ACCOUNT >
#   GOOGLE_CLIENT_EMAIL + GOOGLE_PRIVATE_KEY > google.json local > ADC.
GOOGLE_APPLICATION_CREDENTIALS=   # chemin absolu vers le JSON du compte de service
GOOGLE_SERVICE_ACCOUNT=           # ou le meme JSON en ligne (deploiement sans fichier)
GOOGLE_CLIENT_EMAIL=              # ou paire eclatee : email du compte de service
GOOGLE_PRIVATE_KEY=               #   + cle privee PEM (sauts de ligne en \n)
GOOGLE_CLOUD_PROJECT=             # id projet GCP (doit matcher le compte de service ; ADC)
# Identifiants de calendriers et cles d'API publiques
GOOGLE_CALENDAR_ID=
GOOGLE_EVENTS_CALENDAR_ID=
GOOGLE_RGTV_CALENDAR_ID=
GOOGLE_CALENDAR_API_KEY=
GOOGLE_API_KEY=                   # Sheets privees / YouTube Data
YOUTUBE_API_KEY=                  # alias prioritaire pour l'API YouTube Data
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Connexion sociale « Google » (Better Auth, packages/rg-auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Delegation proprietaire (Gmail/Calendar en ecriture) via `env-kit google-auth <surface>`
GOOGLE_INSTALLED_CLIENT_ID=
GOOGLE_INSTALLED_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=             # ou GOOGLE_<SURFACE>_REFRESH_TOKEN par surface

# ─── Achillea ranked (`rosegriffon ranked`) ───────────────────────────────────
RANKED_PORT=
RANKED_HOST=
RANKED_ALLOWED_ORIGINS=
RANKED_INTERNAL_SECRET=
RANKED_PROOF_CHANNEL_ID=
RANKED_STORAGE_DIR=

# ─── nie-model-serve (external Rust model server, reached by URL or binary path) ──
NIE_MODEL_SERVE_URL=
NIE_MODEL_SERVE_BIN=
NIE_MODEL_SERVE_PORT=
NIE_MODEL_SERVE_THREADS=
NIE_MODEL_SERVE_ARGS=
NIE_MODEL_CACHE_DIR=
NIE_GAME_DIR=

# ─── Steam depot (`steam-depot` tools service, aphrody-dev/steam-depot (src crates/steam-depot) `bun-steam-depot`) ──
# One interactive `login`; afterwards the refresh token is renewed and rotated automatically.
# The password and Steam Guard code are typed on the TTY only and never stored.
STEAM_HOME=/srv/rosegriffon/steam
STEAM_INSTALL_DIR=/srv/rosegriffon/game/ievr
STEAM_ACCOUNT_NAME=
STEAM_USER=
STEAM_APP_ID=2799860
STEAM_PLATFORM=windows
STEAM_MAX_DOWNLOADS=32
STEAM_MAX_RATE=0
# Canonical token store: file (STEAM_HOME/steam-tokens.json, 0600) | env | cloudflare | github
STEAM_TOKEN_STORE=file
# env / github stores (CI): injected from the repository secret, never committed
STEAM_REFRESH_TOKEN=
# github store: rotation written back with `gh secret set` (stdin)
STEAM_TOKEN_GH_SECRET=STEAM_REFRESH_TOKEN
STEAM_TOKEN_GH_REPO=
# cloudflare store: Workers KV namespace, read/write
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
STEAM_TOKEN_KV_NAMESPACE_ID=
STEAM_TOKEN_KV_PREFIX=steam-refresh-token
# Steam Web API key for the steam plugin MCP server (plugins/steam); optional, see its README.
STEAM_WEB_API_KEY=

# ─── CDN sync (`cdn-sync` tools service, infra/docker/cdn-sync) ───────────────
# Publishes /srv/rosegriffon/cdn/static (derived public assets only) to S3-compatible buckets.
CDN_SYNC_SOURCE=/data/cdn/static
CDN_SYNC_PREFIX=static/
CDN_SYNC_TARGETS=r2
CDN_SYNC_CONCURRENCY=16
# Cloudflare R2 (S3 API token scoped to the bucket, Object Read & Write)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Any other S3 endpoint (AWS, MinIO, OVH, ...), enabled by adding `s3` to CDN_SYNC_TARGETS
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
