# rosegriffon — environment of the self-hosted executable (names only, no values).
# Copy to `.env` next to the executable or pass `--env-file <path>`.
# Per-app references: apps/rg-website/.env.example, apps/rg-bot/.env.example,
# packages/rg-cron/.env.example.

# ─── Databases ────────────────────────────────────────────────────────────────
# Supabase project `rg` (Postgres, Auth, Storage, Realtime)
RG_DATABASE_URL=
DATABASE_URL=
DATABASE_POOL_MAX=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Neon project `inagle` (game data mirror, pooled endpoint)
INAGLE_DATABASE_URL=
REDIS_URL=

# ─── Site (`rosegriffon site`) ────────────────────────────────────────────────
RG_SITE=
RG_SITE_PORT=
RG_SITE_HOST=
RG_SITE_DIR=
RG_CACHE_DIR=
NEXT_PUBLIC_BASE_URL=
WEBSITE_URL=

# ─── rg-core (`rosegriffon serve`) ────────────────────────────────────────────
RG_CORE_PORT=
RG_CORE_HOST=
RG_CORE_CRON=
RG_CORE_CRON_EXCLURE=
RG_CORE_AZALEE=
RG_CORE_MODELES=
RG_CORE_MODEL_HOSTS=
RG_CORE_BOT_HOSTS=
RG_CORE_VEILLE_MESSAGES=
RG_PROFIL_BOT=

# ─── Unified API (`rosegriffon api`) ──────────────────────────────────────────
API_PORT=
API_HOST=
API_ADMIN_TOKEN=
BOT_API_TOKEN=
UNIFIED_API_URL=
WEB_ALLOWED_ORIGINS=
CRON_SECRET=

# ─── Discord (`rosegriffon bot`) ──────────────────────────────────────────────
DISCORD_BOT_TOKEN=
AZALEE_DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
BOT_SYNC_MEMBRES=
SYNC_INTERVAL_MS=

# ─── Achillea ranked (`rosegriffon ranked`) ───────────────────────────────────
RANKED_PORT=
RANKED_HOST=
RANKED_ALLOWED_ORIGINS=
RANKED_INTERNAL_SECRET=
RANKED_PROOF_CHANNEL_ID=
RANKED_STORAGE_DIR=

# ─── nie-model-serve (bun-os product, reached by URL or binary path) ──────────
NIE_MODEL_SERVE_URL=
NIE_MODEL_SERVE_BIN=
NIE_MODEL_SERVE_PORT=
NIE_MODEL_SERVE_THREADS=
NIE_MODEL_SERVE_ARGS=
NIE_MODEL_CACHE_DIR=
NIE_GAME_DIR=
